n    # Slide 12: Call to Action\n    slide = prs.slides.add_slide(content_layout)\n    for placeholder in slide.placeholders:\n        if placeholder.placeholder_format.type == 1:\n            placeholder.text = "Ready to Experience the Future?"\n        elif placeholder.placeholder_format.type == 2:\n            placeholder.text = """🚀 Free Registration & Trial:\nhttps://dobby.DrPang.AI\n\nExperience Advantages:\n• Superior content creation quality\n• Professional PPT generation features\n• Rich illustrated article creation\n• Chinese localization experience\n• Convenient payment integration\n\nJoin the AI agent revolution today!\n\nUsers will be able to hire Dobby to complete work,\neasily create professional content,\nand share with other users to earn credits."""\n    \n    # Apply consistent styling to content slides\n    for slide in prs.slides[1:]:  # Skip the title slide\n        for shape in slide.shapes:\n            if shape.has_text_frame:\n                for paragraph in shape.text_frame.paragraphs:\n                    if paragraph.font.size is None or paragraph.font.size < Pt(14):\n                        paragraph.font.size = Pt(16)\n                    paragraph.space_after = Pt(6)\n    \n    # Save the presentation\n    prs.save(\'dobby_business_plan_with_template.pptx\')\n    print("PowerPoint presentation with template created successfully: dobby_business_plan_with_template.pptx")\n\nif __name__ == "__main__":\n    create_dobby_ppt_with_template()'}
