        color: #667eea;\\n            font-size: 2.2em;\\n            margin-bottom: 25px;\\n            padding-bottom: 15px;\\n            border-bottom: 2px solid #e0e0e0;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .section h2::before {\\n            content: \'\\ud83c\\udfa3\';\\n            margin-right: 15px;\\n            font-size: 1.2em;\\n        }\\n\\n        .section h3 {\\n            color: #555;\\n            font-size: 1.6em;\\n            margin: 30px 0 20px 0;\\n            padding-left: 20px;\\n            border-left: 3px solid #667eea;\\n        }\\n\\n        .section h4 {\\n            color: #666;\\n            font-size: 1.3em;\\n            margin: 25px 0 15px 0;\\n            font-weight: 600;\\n        }\\n\\n        .section p {\\n            margin-bottom: 20px;\\n            text-align: justify;\\n            font-size: 1.1em;\\n            line-height: 1.8;\\n        }\\n\\n        .image-container {\\n            margin: 30px 0;\\n            text-align: center;\\n            border-radius: 15px;\\n            overflow: hidden;\\n            box-shadow: 0 8px 25px rgba(0,0,0,0.15);\\n        }\\n\\n        .image-container img {\\n            width: 100%;\\n            height: auto;\\n            display: block;\\n            transition: transform 0.3s ease;\\n        }\\n\\n        .image-container:hover img {\\n            transform: scale(1.05);\\n        }\\n\\n        .image-caption {\\n            background: #f8f9fa;\\n            padding: 15px;\\n            font-style: italic;\\n            color: #666;\\n            border-top: 1px solid #e0e0e0;\\n        }\\n\\n        .location-grid {\\n            display: grid;\\n            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));\\n            gap: 30px;\\n            margin: 30px 0;\\n        }\\n\\n        .location-card {\\n            background: white;\\n            border-radius: 15px;\\n            padding: 25px;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\\n        }\\n\\n        .location-card:hover {\\n            transform: translateY(-5px);\\n            box-shadow: 0 10px 30px rgba(0,0,0,0.15);\\n        }\\n\\n        .location-card h4 {\\n            color: #667eea;\\n            font-size: 1.4em;\\n            margin-bottom: 15px;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .location-card h4::before {\\n            content: \'\\ud83d\\udccd\';\\n            margin-right: 10px;\\n        }\\n\\n        .tips-box {\\n            background: linear-gradient(135deg, #ffeaa7 0%, #fab1a0 100%);\\n            border-radius: 15px;\\n            padding: 25px;\\n            margin: 30px 0;\\n            border-left: 5px solid #e17055;\\n        }\\n\\n        .tips-box h4 {\\n            color: #d63031;\\n            margin-bottom: 15px;\\n            font-size: 1.3em;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .tips-box h4::before {\\n            content: \'\\ud83d\\udca1\';\\n            margin-right: 10px;\\n        }\\n\\n        .warning-box {\\n            background: linear-gradient(135deg, #ff7675 0%, #fd79a8 100%);\\n            color: white;\\n            border-radius: 15px;\\n            padding: 25px;\\n            margin: 30px 0;\\n            border-left: 5px solid #e84393;\\n        }\\n\\n        .warning-box h4 {\\n            margin-bottom: 15px;\\n            font-size: 1.3em;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .warning-box h4::before {\\n            content: \'\\u26a0\\ufe0f\';\\n            margin-right: 10px;\\n        }\\n\\n        .equipment-grid {\\n            display: grid;\\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\\n            gap: 20px;\\n            margin: 30px 0;\\n        }\\n\\n        .equipment-item {\\n            background: white;\\n            border-radius: 10px;\\n            padding: 20px;\\n            text-align: center;\\n            box-shadow: 0 3px 15px rgba(0,0,0,0.1);\\n            transition: transform 0.3s ease;\\n        }\\n\\n        .equipment-item:hover {\\n            transform: translateY(-3px);\\n        }\\n\\n        .equipment-item h5 {\\n            color: #667eea;\\n            margin-bottom: 10px;\\n            font-size: 1.2em;\\n        }\\n\\n        .season-timeline {\\n            display: flex;\\n            justify-content: space-between;\\n            margin: 30px 0;\\n            flex-wrap: wrap;\\n            gap: 20px;\\n        }\\n\\n        .season-item {\\n            flex: 1;\\n            min-width: 200px;\\n            background: white;\\n            border-radius: 15px;\\n            padding: 25px;\\n            text-align: center;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n            position: relative;\\n            overflow: hidden;\\n        }\\n\\n        .season-item::before {\\n            content: \'\';\\n            position: absolute;\\n            top: 0;\\n            left: 0;\\n            right: 0;\\n            height: 5px;\\n            background: linear-gradient(90deg, #667eea, #764ba2);\\n        }\\n\\n        .season-item h4 {\\n            color: #667eea;\\n            margin-bottom: 15px;\\n            font-size: 1.3em;\\n        }\\n\\n        .fish-gallery {\\n            display: grid;\\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\\n            gap: 20px;\\n            margin: 30px 0;\\n        }\\n\\n        .fish-card {\\n            background: white;\\n            border-radius: 15px;\\n            overflow: hidden;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n            transition: transform 0.3s ease;\\n        }\\n\\n        .fish-card:hover {\\n            transform: scale(1.05);\\n        }\\n\\n        .fish-card img {\\n            width: 100%;\\n            height: 150px;\\n            object-fit: cover;\\n        }\\n\\n        .fish-card-content {\\n            padding: 15px;\\n        }\\n\\n        .fish-card h5 {\\n            color: #667eea;\\n            margin-bottom: 10px;\\n            font-size: 1.1em;\\n        }\\n\\n        .footer {\\n            background: #2d3436;\\n            color: white;\\n            padding: 40px;\\n            text-align: center;\\n        }\\n\\n        .footer h3 {\\n            margin-bottom: 20px;\\n            color: #74b9ff;\\n        }\\n\\n        @media (max-width: 768px) {\\n            .header h1 {\\n                font-size: 2.5em;\\n            }\\n            \\n            .content {\\n                padding: 30px 20px;\\n            }\\n            \\n            .section {\\n                padding: 20px;\\n            }\\n            \\n            .location-grid {\\n                grid-template-columns: 1fr;\\n            }\\n            \\n            .season-timeline {\\n                flex-direction: column;\\n            }\\n        }\\n\\n        .table-container {\\n            overflow-x: auto;\\n            margin: 30px 0;\\n            border-radius: 15px;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n        }\\n\\n        table {\\n            width: 100%;\\n            border-collapse: collapse;\\n            background: white;\\n        }\\n\\n        th, td {\\n            padding: 15px;\\n            text-align: left;\\n            border-bottom: 1px solid #e0e0e0;\\n        }\\n\\n        th {\\n            background: #667eea;\\n            color: white;\\n            font-weight: 600;\\n        }\\n\\n        tr:hover {\\n            background: #f8f9fa;\\n        }\\n\\n        .highlight {\\n            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);\\n            padding: 20px;\\n            border-radius: 15px;\\n            margin: 20px 0;\\n            border-left: 5px solid #00b894;\\n        }\\n    </style>\\n</head>\\n<body>\\n    <div class=\\"container\\">\\n        <header class=\\"header\\">\\n            <div class=\\"header-content\\">\\n                <h1>\\u5782\\u9493\\u4e50\\u8da3\\uff5c\\u4e0a\\u6d77\\u91ce\\u9493\\u5b8c\\u5168\\u6307\\u5357</h1>\\n                <p class=\\"subtitle\\">\\u63a2\\u7d22\\u9b54\\u90fd\\u6c34\\u57df\\uff0c\\u4eab\\u53d7\\u5782\\u9493\\u4e50\\u8da3\\u7684\\u7ec8\\u6781\\u6307\\u5357</p>\\n            </div>\\n        </header>\\n\\n        <div class=\\"content\\">\\n            <!-- \\u5f15\\u8a00\\u90e8\\u5206 -->\\n            <div class=\\"section\\">\\n                <h2>\\u5f15\\u8a00\\uff1a\\u9b54\\u90fd\\u7684\\u5782\\u9493\\u9b45\\u529b</h2>\\n                <div class=\\"image-container\\">\\n                    <img src=\\"https://images.unsplash.com/photo-1559827260-dc66d52bef19?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80\\" alt=\\"\\u4e0a\\u6d77\\u9ec4\\u6d66\\u6c5f\\u7554\\u9493\\u9c7c\\">\\n                    <div class=\\"image-caption\\">\\u9ec4\\u6d66\\u6c5f\\u7554\\u7684\\u5782\\u9493\\u98ce\\u5149</div>\\n                </div>\\n                <p>\\u4e0a\\u6d77\\uff0c\\u8fd9\\u5ea7\\u56fd\\u9645\\u5316\\u5927\\u90fd\\u5e02\\uff0c\\u4e0d\\u4ec5\\u4ee5\\u5176\\u7e41\\u534e\\u7684\\u5546\\u4e1a\\u533a\\u548c\\u6469\\u5929\\u5927\\u697c\\u95fb\\u540d\\uff0c\\u66f4\\u62e5\\u6709\\u4e30\\u5bcc\\u7684\\u6c34\\u57df\\u8d44\\u6e90\\uff0c\\u4e3a\\u5782\\u9493\\u7231\\u597d\\u8005\\u63d0\\u4f9b\\u4e86\\u7edd\\u4f73\\u7684\\u91ce\\u9493\\u73af\\u5883\\u3002\\u4ece\\u5d07\\u660e\\u5c9b\\u7684\\u81ea\\u7136\\u6e7f\\u5730\\u5230\\u5e02\\u533a\\u7684\\u516c\\u56ed\\u6e56\\u6cca\\uff0c\\u4ece\\u9ec4\\u6d66\\u6c5f\\u7684\\u652f\\u6d41\\u5230\\u90ca\\u533a\\u7684\\u6c34\\u5e93\\uff0c\\u4e0a\\u6d77\\u7684\\u91ce\\u9493\\u8d44\\u6e90\\u53ef\\u8c13\\u5f97\\u5929\\u72ec\\u539a\\u3002</p>\\n                <p>\\u672c\\u6307\\u5357\\u5c06\\u4e3a\\u60a8\\u8be6\\u