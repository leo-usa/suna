d>\\n                                <td>\\u5168\\u5e74</td>\\n                                <td>\\u86cb\\u767d\\u8d28\\u542b\\u91cf\\u9ad8\\uff0c\\u8bf1\\u9c7c\\u6548\\u679c\\u597d</td>\\n                            </tr>\\n                        </tbody>\\n                    </table>\\n                </div>\\n\\n                <h3>\\u88c5\\u5907\\u9009\\u8d2d\\u5efa\\u8bae</h3>\\n                <div class=\\"tips-box\\">\\n                    <h4>\\u65b0\\u624b\\u88c5\\u5907\\u5efa\\u8bae</h4>\\n                    <p><strong>\\u9884\\u7b97\\u63a7\\u5236\\uff1a</strong>\\u521d\\u5b66\\u8005\\u5efa\\u8bae\\u5148\\u8d2d\\u4e70\\u4e2d\\u7b49\\u4ef7\\u4f4d\\u88c5\\u5907\\uff0c\\u968f\\u7740\\u6280\\u672f\\u63d0\\u5347\\u518d\\u9010\\u6b65\\u5347\\u7ea7\\u3002</p>\\n                    <p><strong>\\u54c1\\u724c\\u9009\\u62e9\\uff1a</strong>\\u9009\\u62e9\\u77e5\\u540d\\u54c1\\u724c\\uff0c\\u8d28\\u91cf\\u6709\\u4fdd\\u969c\\uff0c\\u552e\\u540e\\u670d\\u52a1\\u5b8c\\u5584\\u3002</p>\\n                    <p><strong>\\u5b9e\\u7528\\u4e3a\\u4e3b\\uff1a</strong>\\u907f\\u514d\\u4e00\\u6b21\\u6027\\u8d2d\\u4e70\\u8fc7\\u591a\\u88c5\\u5907\\uff0c\\u6839\\u636e\\u5b9e\\u9645\\u9700\\u8981\\u9010\\u6b65\\u6dfb\\u7f6e\\u3002</p>\\n                    <p><strong>\\u5b89\\u5168\\u7b2c\\u4e00\\uff1a</strong>\\u9009\\u62e9\\u8d28\\u91cf\\u53ef\\u9760\\u7684\\u88c5\\u5907\\uff0c\\u7279\\u522b\\u662f\\u9c7c\\u7aff\\u548c\\u9c7c\\u7ebf\\uff0c\\u907f\\u514d\\u65ad\\u7aff\\u65ad\\u7ebf\\u3002</p>\\n                </div>\\n            </div>\\n\\n            <!-- \\u5b89\\u5168\\u6ce8\\u610f\\u4e8b\\u9879 -->\\n            <div class=\\"section\\">\\n                <h2>\\u5b89\\u5168\\u5782\\u9493\\u6307\\u5357</h2>\\n                <div class=\\"image-container\\">\\n                    <img src=\\"https://images.unsplash.com/photo-1551698618-1dfe5d97d256?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80\\" alt=\\"\\u5b89\\u5168\\u5782\\u9493\\">\\n                    <div class=\\"image-caption\\">\\u5b89\\u5168\\u7b2c\\u4e00\\uff0c\\u4eab\\u53d7\\u5782\\u9493\\u4e50\\u8da3</div>\\n                </div>\\n\\n                <h3>\\u6c34\\u8fb9\\u5b89\\u5168</h3>\\n                <div class=\\"warning-box\\">\\n                    <h4>\\u6c34\\u8fb9\\u5b89\\u5168\\u8b66\\u793a</h4>\\n                    <p><strong>\\u9009\\u62e9\\u5b89\\u5168\\u9493\\u4f4d\\uff1a</strong>\\u907f\\u514d\\u5728\\u9661\\u5ced\\u3001\\u6e7f\\u6ed1\\u7684\\u5cb8\\u8fb9\\u5782\\u9493\\uff0c\\u9009\\u62e9\\u5e73\\u5766\\u7a33\\u56fa\\u7684\\u9493\\u4f4d\\u3002</p>\\n                    <p><strong>\\u6ce8\\u610f\\u6c34\\u6df1\\uff1a</strong>\\u4e86\\u89e3\\u9493\\u70b9\\u6c34\\u6df1\\u60c5\\u51b5\\uff0c\\u907f\\u514d\\u5728\\u6df1\\u6c34\\u533a\\u57df\\u65e0\\u9632\\u62a4\\u63aa\\u65bd\\u5782\\u9493\\u3002</p>\\n                    <p><strong>\\u5929\\u6c14\\u5173\\u6ce8\\uff1a</strong>\\u907f\\u514d\\u5728\\u96f7\\u96e8\\u3001\\u5927\\u98ce\\u7b49\\u6076\\u52a3\\u5929\\u6c14\\u51fa\\u9493\\u3002</p>\\n                    <p><strong>\\u7ed3\\u4f34\\u51fa\\u884c\\uff1a</strong>\\u5c3d\\u91cf\\u7ed3\\u4f34\\u5782\\u9493\\uff0c\\u76f8\\u4e92\\u7167\\u5e94\\uff0c\\u786e\\u4fdd\\u5b89\\u5168\\u3002</p>\\n                </div>\\n\\n                <h3>\\u88c5\\u5907\\u5b89\\u5168</h3>\\n                <p>\\u5b9a\\u671f\\u68c0\\u67e5\\u9c7c\\u7aff\\u3001\\u9c7c\\u7ebf\\u7b49\\u88c5\\u5907\\u7684\\u5b8c\\u597d\\u6027\\uff0c\\u53ca\\u65f6\\u66f4\\u6362\\u8001\\u5316\\u635f\\u574f\\u7684\\u88c5\\u5907\\u3002\\u4f7f\\u7528\\u950b\\u5229\\u7684\\u9c7c\\u94a9\\u65f6\\u8981\\u683c\\u5916\\u5c0f\\u5fc3\\uff0c\\u907f\\u514d\\u610f\\u5916\\u4f24\\u5bb3\\u3002\\u643a\\u5e26\\u7b80\\u5355\\u7684\\u6025\\u6551\\u7528\\u54c1\\uff0c\\u5982\\u521b\\u53ef\\u8d34\\u3001\\u6d88\\u6bd2\\u6db2\\u7b49\\u3002</p>\\n\\n                <h3>\\u73af\\u5883\\u4fdd\\u62a4</h3>\\n                <p>\\u5782\\u9493\\u65f6\\u8981\\u7231\\u62a4\\u73af\\u5883\\uff0c\\u4e0d\\u4e71\\u6254\\u5783\\u573e\\uff0c\\u4fdd\\u6301\\u9493\\u70b9\\u6e05\\u6d01\\u3002\\u9075\\u5faa\\"\\u9493\\u83b7\\u653e\\u6d41\\"\\u7684\\u539f\\u5219\\uff0c\\u9002\\u91cf\\u5782\\u9493\\uff0c\\u4fdd\\u62a4\\u9c7c\\u7c7b\\u8d44\\u6e90\\u3002\\u4e0d\\u4f7f\\u7528\\u7535\\u9c7c\\u3001\\u6bd2\\u9c7c\\u7b49\\u8fdd\\u6cd5\\u624b\\u6bb5\\uff0c\\u5171\\u540c\\u7ef4\\u62a4\\u826f\\u597d\\u7684\\u5782\\u9493\\u73af\\u5883\\u3002</p>\\n\\n                <div class=\\"tips-box\\">\\n                    <h4>\\u7d27\\u6025\\u60c5\\u51b5\\u5904\\u7406</h4>\\n                    <p><strong>\\u843d\\u6c34\\u81ea\\u6551\\uff1a</strong>\\u4fdd\\u6301\\u51b7\\u9759\\uff0c\\u5c3d\\u91cf\\u6293\\u4f4f\\u6f02\\u6d6e\\u7269\\uff0c\\u5927\\u58f0\\u547c\\u6551\\u3002</p>\\n                    <p><strong>\\u4ed6\\u4eba\\u843d\\u6c34\\uff1a</strong>\\u7acb\\u5373\\u62a5\\u8b66\\uff0c\\u5bfb\\u627e\\u6551\\u751f\\u8bbe\\u5907\\uff0c\\u4e0d\\u8981\\u8d38\\u7136\\u4e0b\\u6c34\\u6551\\u4eba\\u3002</p>\\n                    <p><strong>\\u610f\\u5916\\u53d7\\u4f24\\uff1a</strong>\\u53ca\\u65f6\\u5904\\u7406\\u4f24\\u53e3\\uff0c\\u4e25\\u91cd\\u60c5\\u51b5\\u7acb\\u5373\\u5c31\\u533b\\u3002</p>\\n                    <p><strong>\\u8ff7\\u8def\\u8d70\\u5931\\uff1a</strong>\\u4fdd\\u6301\\u51b7\\u9759\\uff0c\\u4f7f\\u7528\\u624b\\u673a\\u5b9a\\u4f4d\\uff0c\\u8054\\u7cfb\\u6551\\u63f4\\u3002</p>\\n                </div>\\n            </div>\\n\\n            <!-- \\u9493\\u53cb\\u4ea4\\u6d41\\u4e0e\\u793e\\u7fa4 -->\\n            <div class=\\"section\\">\\n                <h2>\\u9493\\u53cb\\u4ea4\\u6d41\\u4e0e\\u5b66\\u4e60</h2>\\n                <div class=\\"image-container\\">\\n                    <img src=\\"https://images.unsplash.com/photo-1559827260-dc66d52bef19?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80\\" alt=\\"\\u9493\\u53cb\\u4ea4\\u6d41\\">\\n                    <div class=\\"image-caption\\">\\u9493\\u53cb\\u4e4b\\u95f4\\u7684\\u4ea4\\u6d41\\u662f\\u63d0\\u5347\\u6280\\u672f\\u7684\\u91cd\\u8981\\u9014\\u5f84</div>\\n                </div>\\n\\n                <h3>\\u7ebf\\u4e0a\\u4ea4\\u6d41\\u5e73\\u53f0</h3>\\n                <p>\\u4e0a\\u6d77\\u6709\\u4f17\\u591a\\u9493\\u9c7c\\u8bba\\u575b\\u548c\\u5fae\\u4fe1\\u7fa4\\uff0c\\u9493\\u53cb\\u4eec\\u53ef\\u4ee5\\u5728\\u8fd9\\u4e9b\\u5e73\\u53f0\\u4e0a\\u5206\\u4eab\\u7ecf\\u9a8c\\u3001\\u4ea4\\u6d41\\u6280\\u5de7\\u3001\\u53d1\\u5e03\\u9493\\u51b5\\u4fe1\\u606f\\u3002\\u63a8\\u8350\\u5173\\u6ce8\\"\\u4e0a\\u6d77\\u9493\\u9c7c\\u7f51\\"\\u3001\\"\\u4e0a\\u6d77\\u91ce\\u9493\\u8bba\\u575b\\"\\u7b49\\u4e13\\u4e1a\\u5e73\\u53f0\\uff0c\\u83b7\\u53d6\\u6700\\u65b0\\u7684\\u9493\\u70b9\\u4fe1\\u606f\\u548c\\u6280\\u672f\\u5206\\u4eab\\u3002</p>\\n\\n                <h3>\\u7ebf\\u4e0b\\u6d3b\\u52a8\\u53c2\\u4e0e</h3>\\n                <p>\\u5b9a\\u671f\\u53c2\\u52a0\\u9493\\u53cb\\u805a\\u4f1a\\u3001\\u6bd4\\u8d5b\\u6d3b\\u52a8\\uff0c\\u4e0d\\u4ec5\\u53ef\\u4ee5\\u5b66\\u4e60\\u5230\\u66f4\\u591a\\u6280\\u5de7\\uff0c\\u8fd8\\u80fd\\u7ed3\\u8bc6\\u5fd7\\u540c\\u9053\\u5408\\u7684\\u670b\\u53cb\\u3002\\u4e0a\\u6d77\\u5730\\u533a\\u7ecf\\u5e38\\u4e3e\\u529e\\u5404\\u7c7b\\u9493\\u9c7c\\u6bd4\\u8d5b\\u548c\\u4ea4\\u6d41\\u6d3b\\u52a8\\uff0c\\u65b0\\u624b\\u53ef\\u4ee5\\u901a\\u8fc7\\u53c2\\u4e0e\\u8fd9\\u4e9b\\u6d3b\\u52a8\\u5feb\\u901f\\u63d0\\u5347\\u6280\\u672f\\u6c34\\u5e73\\u3002</p>\\n\\n                <h3>\\u6280\\u672f\\u5b66\\u4e60\\u5efa\\u8bae</h3>\\n                <div class=\\"highlight\\">\\n                    <p><strong>\\u7406\\u8bba\\u5b66\\u4e60\\uff1a</strong>\\u901a\\u8fc7\\u4e66\\u7c4d\\u3001\\u89c6\\u9891\\u7b49\\u9014\\u5f84\\u5b66\\u4e60\\u9493\\u9c7c\\u7406\\u8bba\\u77e5\\u8bc6\\uff0c\\u4e86\\u89e3\\u9c7c\\u7c7b\\u4e60\\u6027\\u3001\\u6c34\\u60c5\\u5206\\u6790\\u7b49\\u3002</p>\\n                    <p><strong>\\u5b9e\\u8df5\\u79ef\\u7d2f\\uff1a</strong>\\u591a\\u51fa\\u9493\\uff0c\\u591a\\u5b9e\\u8df5\\uff0c\\u5728\\u5b9e\\u9645\\u64cd\\u4f5c\\u4e2d\\u79ef\\u7d2f\\u7ecf\\u9a8c\\uff0c\\u63d0\\u5347\\u6280\\u672f\\u3002</p>\\n                    <p><strong>\\u865a\\u5fc3\\u8bf7\\u6559\\uff1a</strong>\\u5411\\u7ecf\\u9a8c\\u4e30\\u5bcc\\u7684\\u8001\\u9493\\u53cb\\u8bf7\\u6559\\uff0c\\u5b66\\u4e60\\u4ed6\\u4eec\\u7684\\u6210\\u529f\\u7ecf\\u9a8c\\u3002</p>\\n                    <p><strong>\\u8bb0\\u5f55\\u603b\\u7ed3\\uff1a</strong>\\u5efa\\u7acb\\u9493\\u9c7c\\u65e5\\u8bb0\\uff0c\\u8bb0\\u5f55\\u6bcf\\u6b21\\u51fa\\u9493\\u7684\\u60c5\\u51b5\\uff0c\\u603b\\u7ed3\\u7ecf\\u9a8c\\u6559\\u8bad\\u3002</p>\\n                </div>\\n            </div>\\n        </div>\\n\\n        <footer class=\\"footer\\">\\n            <h3>\\ud83c\\udfa3 \\u613f\\u6bcf\\u4e00\\u6b21\\u51fa\\u9493\\u90fd\\u6709\\u6ee1\\u6ee1\\u6536\\u83b7 \\ud83c\\udfa3</h3>\\n            <p>\\u4e0a\\u6d77\\u91ce\\u9493\\u5b8c\\u5168\\u6307\\u5357 - \\u8ba9\\u5782\\u9493\\u6210\\u4e3a\\u751f\\u6d3b\\u4e2d\\u6700\\u7f8e\\u597d\\u7684\\u65f6\\u5149</p>\\n            <p>\\u5b89\\u5168\\u5782\\u9493 \\u00b7 \\u6587\\u660e\\u5782\\u9493 \\u00b7 \\u73af\\u4fdd\\u5782\\u9493</p>\\n            <p style=\\"margin-top: 20px; font-size: 0.9em; opacity: 0.8;\\">\\n                \\u672c\\u6307\\u5357\\u4ec5\\u4f9b\\u53c2\\u8003\\uff0c\\u5177\\u4f53\\u9493\\u70b9\\u548c\\u6cd5\\u89c4\\u8bf7\\u4ee5\\u5f53\\u5730\\u6700\\u65b0\\u89c4\\u5b9a\\u4e3a\\u51c6\\n            </p>\\n        </footer>\\n    </div>\\n</body>\\n</html>", "raw_chunk": "<create-file file_path=\\"shanghai_fishing_guide.html\\">\\n<!DOCTYPE html>\\n<html lang=\\"zh-CN\\">\\n<head>\\n    <meta charset=\\"UTF-8\\">\\n    <meta name=\\"viewport\\" content=\\"width=device-width, initial-scale=1.0\\">\\n    <title>\\u5782\\u9493\\u4e50\\u8da3\\uff5c\\u4e0a\\u6d77\\u91ce\\u9493\\u5b8c\\u5168\\u6307\\u5357</title>\\n    <style>\\n        * {\\n            margin: 0;\\n            padding: 0;\\n            box-sizing: border-box;\\n        }\\n\\n        body {\\n            font-family: \'Microsoft YaHei\', \'PingFang SC\', \'Helvetica Neue\', Arial, sans-serif;\\n            line-height: 1.8;\\n            color: #333;\\n            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);\\n            min-height: 100vh;\\n        }\\n\\n        .container {\\n            max-width: 1200px;\\n            margin: 0 auto;\\n            background: white;\\n            box-shadow: 0 0 30px rgba(0,0,0,0.1);\\n            border-radius: 15px;\\n            overflow: hidden;\\n        }\\n\\n        .header {\\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n            color: white;\\n            padding: 60px 40px;\\n            text-align: center;\\n            position: relative;\\n            overflow: hidden;\\n        }\\n\\n        .header::before {\\n            content: \'\';\\n            position: absolute;\\n            top: 0;\\n            left: 0;\\n            right: 0;\\n            bottom: 0;\\n            background: url(\'https://images.unsplash.com/photo-1544551763-46a013bb70d5?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80\') center/cover;\\n            opacity: 0.2;\\n            z-index: 1;\\n        }\\n\\n        .header-content {\\n            position: relative;\\n            z-index: 2;\\n        }\\n\\n        .header h1 {\\n            font-size: 3.5em;\\n            margin-bottom: 20px;\\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\\n            font-weight: 700;\\n        }\\n\\n        .header .subtitle {\\n            font-size: 1.3em;\\n            opacity: 0.9;\\n            margin-bottom: 30px;\\n        }\\n\\n        .content {\\n            padding: 50px 40px;\\n        }\\n\\n        .section {\\n            margin-bottom: 60px;\\n            padding: 30px;\\n            border-radius: 15px;\\n            background: #fafafa;\\n            border-left: 5px solid #667eea;\\n        }\\n\\n        .section h2 {\\n            color: #667eea;\\n            font-size: 2.2em;\\n            margin-bottom: 25px;\\n            padding-bottom: 15px;\\n            border-bottom: 2px solid #e0e0e0;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .section h2::before {\\n            content: \'\\ud83c\\udfa3\';\\n            margin-right: 15px;\\n            font-size: 1.2em;\\n        }\\n\\n        .section h3 {\\n            color: #555;\\n            font-size: 1.6em;\\n            margin: 30px 0 20px 0;\\n            padding-left: 20px;\\n            border-left: 3px solid #667eea;\\n        }\\n\\n        .section h4 {\\n            color: #666;\\n            font-size: 1.3em;\\n            margin: 25px 0 15px 0;\\n            font-weight: 600;\\n        }\\n\\n        .section p {\\n            margin-bottom: 20px;\\n            text-align: justify;\\n            font-size: 1.1em;\\n            line-height: 1.8;\\n        }\\n\\n        .image-container {\\n            margin: 30px 0;\\n            text-align: center;\\n            border-radius: 15px;\\n            overflow: hidden;\\n            box-shadow: 0 8px 25px rgba(0,0,0,0.15);\\n        }\\n\\n        .image-container img {\\n            width: 100%;\\n            height: auto;\\n            display: block;\\n            transition: transform 0.3s ease;\\n        }\\n\\n        .image-container:hover img {\\n            transform: scale(1.05);\\n        }\\n\\n        .image-caption {\\n            background: #f8f9fa;\\n            padding: 15px;\\n            font-style: italic;\\n            color: #666;\\n            border-top: 1px solid #e0e0e0;\\n        }\\n\\n        .location-grid {\\n            display: grid;\\n            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));\\n            gap: 30px;\\n            margin: 30px 0;\\n        }\\n\\n        .location-card {\\n            background: white;\\n            border-radius: 15px;\\n            padding: 25px;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\\n        }\\n\\n        .location-card:hover {\\n            transform: translateY(-5px);\\n            box-shadow: 0 10px 30px rgba(0,0,0,0.15);\\n        }\\n\\n        .location-card h4 {\\n            color: #667eea;\\n            font-size: 1.4em;\\n            margin-bottom: 15px;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .location-card h4::before {\\n            content: \'\\ud83d\\udccd\';\\n            margin-right: 10px;\\n        }\\n\\n        .tips-box {\\n            background: linear-gradient(135deg, #ffeaa7 0%, #fab1a0 100%);\\n            border-radius: 15px;\\n            padding: 25px;\\n            margin: 30px 0;\\n            border-left: 5px solid #e17055;\\n        }\\n\\n        .tips-box h4 {\\n            color: #d63031;\\n            margin-bottom: 15px;\\n            font-size: 1.3em;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .tips-box h4::before {\\n            content: \'\\ud83d\\udca1\';\\n            margin-right: 10px;\\n        }\\n\\n        .warning-box {\\n            background: linear-gradient(135deg, #ff7675 0%, #fd79a8 100%);\\n            color: white;\\n            border-radius: 15px;\\n            padding: 25px;\\n            margin: 30px 0;\\n            border-left: 5px solid #e84393;\\n        }\\n\\n        .warning-box h4 {\\n            margin-bottom: 15px;\\n            font-size: 1.3em;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .warning-box h4::before {\\n            content: \'\\u26a0\\ufe0f\';\\n            margin-right: 10px;\\n        }\\n\\n        .equipment-grid {\\n            display: grid;\\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\\n            gap: 20px;\\n            margin: 30px 0;\\n        }\\n\\n        .equipment-item {\\n            background: white;\\n            border-radius: 10px;\\n            padding: 20px;\\n            text-align: center;\\n            box-shadow: 0 3px 15px rgba(0,0,0,0.1);\\n            transition: transform 0.3s ease;\\n        }\\n\\n        .equipment-item:hover {\\n            transform: translateY(-3px);\\n        }\\n\\n        .equipment-item h5 {\\n            color: #667eea;\\n            margin-bottom: 10px;\\n            font-size: 1.2em;\\n        }\\n\\n        .season-timeline {\\n            display: flex;\\n            justify-content: space-between;\\n            margin: 30px 0;\\n            flex-wrap: wrap;\\n            gap: 20px;\\n        }\\n\\n        .season-item {\\n            flex: 1;\\n            min-width: 200px;\\n            background: white;\\n            border-radius: 15px;\\n            padding: 25px;\\n            text-align: center;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n            position: relative;\\n            overflow: hidden;\\n        }\\n\\n        .season-item::before {\\n            content: \'\';\\n            position: absolute;\\n            top: 0;\\n            left: 0;\\n            right: 0;\\n            height: 5px;\\n            background: linear-gradient(90deg, #667eea, #764ba2);\\n        }\\n\\n        .season-item h4 {\\n            color: #667eea;\\n            margin-bottom: 15px;\\n            font-size: 1.3em;\\n        }\\n\\n        .fish-gallery {\\n            display: grid;\\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\\n            gap: 20px;\\n            margin: 30px 0;\\n        }\\n\\n        .fish-card {\\n            background: white;\\n            border-radius: 15px;\\n            overflow: hidden;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n            transition: transform 0.3s ease;\\n        }\\n\\n        .fish-card:hover {\\n            transform: scale(1.05);\\n        }\\n\\n        .fish-card img {\\n            width: 100%;\\n            height: 150px;\\n            object-fit: cover;\\n        }\\n\\n        .fish-card-content {\\n            padding: 15px;\\n        }\\n\\n        .fish-card h5 {\\n            color: #667eea;\\n            margin-bottom: 10px;\\n            font-size: 1.1em;\\n        }\\n\\n        .footer {\\n            background: #2d3436;\\n            color: white;\\n            padding: 40px;\\n            text-align: center;\\n        }\\n\\n        .footer h3 {\\n            margin-bottom: 20px;\\n            color: #74b9ff;\\n        }\\n\\n        @media (max-width: 768px) {\\n            .header h1 {\\n                font-size: 2.5em;\\n            }\\n            \\n            .content {\\n                padding: 30px 20px;\\n            }\\n            \\n            .section {\\n                padding: 20px;\\n            }\\n            \\n            .location-grid {\\n                grid-template-columns: 1fr;\\n            }\\n            \\n            .season-timeline {\\n                flex-direction: column;\\n            }\\n        }\\n\\n        .table-container {\\n            overflow-x: auto;\\n            margin: 30px 0;\\n            border-radius: 15px;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n        }\\n\\n        table {\\n            width: 100%;\\n            border-collapse: collapse;\\n            background: white;\\n        }\\n\\n        th, td {\\n            padding: 15px;\\n            text-align: left;\\n            border-bottom: 1px solid #e0e0e0;\\n        }\\n\\n        th {\\n            background: #667eea;\\n            color: white;\\n            font-weight: 600;\\n        }\\n\\n        tr:hover {\\n            background: #f8f9fa;\\n        }\\n\\n        .highlight {\\n            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);\\n            padding: 20px;\\n            border-radius: 15px;\\n            margin: 20px 0;\\n            border-left: 5px solid #00b894;\\n        }\\n    </style>\\n</head>\\n<body>\\n    <div class=\\"container\\">\\n        <header class=\\"header\\">\\n            <div class=\\"header-content\\">\\n                <h1>\\u5782\\u9493\\u4e50\\u8da3\\uff5c\\u4e0a\\u6d77\\u91ce\\u9493\\u5b8c\\u5168\\u6307\\u5357</h1>\\n                <p class=\\"subtitle\\">\\u63a2\\u7d22\\u9b54\\u90fd\\u6c34\\u57df\\uff0c\\u4eab\\u53d7\\u5782\\u9493\\u4e50\\u8da3\\u7684\\u7ec8\\u6781\\u6307\\u5357</p>\\n            </div>\\n        </header>\\n\\n        <div class=\\"content\\">\\n            <!-- \\u5f15\\u8a00\\u90e8\\u5206 -->\\n            <div class=\\"section\\">\\n                <h2>\\u5f15\\u8a00\\uff1a\\u9b54\\u90fd\\u7684\\u5782\\u9493\\u9b45\\u529b</h2>\\n                <div class=\\"image-container\\">\\n                    <img src=\\"https://images.unsplash.com/photo-1559827260-dc66d52bef19?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80\\" alt=\\"\\u4e0a\\u6d77\\u9ec4\\u6d66\\u6c5f\\u7554\\u9493\\u9c7c\\">\\n                    <div class=\\"image-caption\\">\\u9ec4\\u6d66\\u6c5f\\u7554\\u7684\\u5782\\u9493\\u98ce\\u5149</div>\\n                </div>\\n                <p>\\u4e0a\\u6d77\\uff0c\\u8fd9\\u5ea7\\u56fd\\u9645\\u5316\\u5927\\u90fd\\u5e02\\uff0c\\u4e0d\\u4ec5\\u4ee5\\u5176\\u7e41\\u534e\\u7684\\u5546\\u4e1a\\u533a\\u548c\\u6469\\u5929\\u5927\\u697c\\u95fb\\u540d\\uff0c\\u66f4\\u62e5\\u6709\\u4e30\\u5bcc\\u7684\\u6c34\\u57df\\u8d44\\u6e90\\uff0c\\u4e3a\\u5782\\u9493\\u7231\\u597d\\u8005\\u63d0\\u4f9b\\u4e86\\u7edd\\u4f73\\u7684\\u91ce\\u9493\\u73af\\u5883\\u3002\\u4ece\\u5d07\\u660e\\u5c9b\\u7684\\u81ea\\u7136\\u6e7f\\u5730\\u5230\\u5e02\\u533a\\u7684\\u516c\\u56ed\\u6e56\\u6cca\\uff0c\\u4ece\\u9ec4\\u6d66\\u6c5f\\u7684\\u652f\\u6d41\\u5230\\u90ca\\u533a\\u7684\\u6c34\\u5e93\\uff0c\\u4e0a\\u6d77\\u7684\\u91ce\\u9493\\u8d44\\u6e90\\u53ef\\u8c13\\u5f97\\u5929\\u72ec\\u539a\\u3002</p>\\n                <p>\\u672c\\u6307\\u5357\\u5c06\\u4e3a\\u60a8\\u8be6\\u7ec6\\u4ecb\\u7ecd\\u4e0a\\u6d77\\u5730\\u533a\\u6700\\u4f73\\u7684\\u91ce\\u9493\\u5730\\u70b9\\u3001\\u76f8\\u5173\\u6cd5\\u89c4\\u3001\\u9493\\u9c7c\\u6280\\u5de7\\u4ee5\\u53ca\\u88c5\\u5907\\u9009\\u62e9\\uff0c\\u5e2e\\u52a9\\u60a8\\u5728\\u8fd9\\u5ea7\\u73b0\\u4ee3\\u5316\\u90fd\\u5e02\\u4e2d\\u627e\\u5230\\u5c5e\\u4e8e\\u81ea\\u5df1\\u7684\\u5782\\u9493\\u4e50\\u56ed\\u3002\\u65e0\\u8bba\\u60a8\\u662f\\u521d\\u5b66\\u8005\\u8fd8\\u662f\\u8d44\\u6df1\\u9493\\u53cb\\uff0c\\u90fd\\u80fd\\u5728\\u8fd9\\u91cc\\u627e\\u5230\\u6709\\u4ef7\\u503c\\u7684\\u4fe1\\u606f\\u548c\\u5b9e\\u7528\\u7684\\u5efa\\u8bae\\u3002</p>\\n            </div>\\n\\n            <!-- \\u4e0a\\u6d77\\u91ce\\u9493\\u5730\\u70b9\\u63a8\\u8350 -->\\n            <div class=\\"section\\">\\n                <h2>\\u4e0a\\u6d77\\u5341\\u5927\\u91ce\\u9493\\u80dc\\u5730</h2>\\n                <div class=\\"image-container\\">\\n                    <img src=\\"https://images.unsplash.com/photo-1578662996442-48f60103fc96?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80\\" alt=\\"\\u4e0a\\u6d77\\u5317\\u6e56\\u98ce\\u666f\\">\\n                    <div class=\\"image-caption\\">\\u4e0a\\u6d77\\u5317\\u6e56 - \\u91ce\\u9493\\u7231\\u597d\\u8005\\u7684\\u5929\\u5802</div>\\n                </div>\\n                \\n                <div class=\\"location-grid\\">\\n                    <div class=\\"location-card\\">\\n                        <h4>\\u4e0a\\u6d77\\u5317\\u6e56</h4>\\n                        <p><strong>\\u4f4d\\u7f6e\\uff1a</strong>\\u5d07\\u660e\\u4e2d\\u90e8\\u5317\\u4fa7</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u6c34\\u57df\\u9762\\u79ef\\u7ea61.2\\u4e07\\u4ea9\\uff0c\\u76f8\\u5f53\\u4e8e2\\u4e2a\\u897f\\u6e56\\u5927\\u5c0f\\uff0c\\u662f\\u4e0a\\u6d77\\u8f83\\u5927\\u7684\\u4eba\\u5de5\\u6e56\\u3002\\u9c7c\\u7c7b\\u8d44\\u6e90\\u4e30\\u5bcc\\uff0c\\u4e3b\\u8981\\u6709\\u9ca4\\u9c7c\\u3001\\u8349\\u9c7c\\u3001\\u9ca2\\u9c7c\\u3001\\u9752\\u9c7c\\u7b49\\u3002</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u6625\\u79cb\\u4e24\\u5b63\\uff0c\\u4e0a\\u534810\\u70b9\\u81f3\\u4e0b\\u53484\\u70b9</p>\\n                        <p><strong>\\u4ea4\\u901a\\uff1a</strong>\\u5730\\u94c1+\\u516c\\u4ea4\\uff0c\\u5efa\\u8bae\\u81ea\\u9a7e\\u524d\\u5f80</p>\\n                    </div>\\n\\n                    <div class=\\"location-card\\">\\n                        <h4>\\u660e\\u73e0\\u6e56\\u00b7\\u897f\\u6c99\\u6e7f\\u5730\\u666f\\u533a</h4>\\n                        <p><strong>\\u4f4d\\u7f6e\\uff1a</strong>\\u5d07\\u660e\\u5c9b\\u897f\\u90e8</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u56fd\\u5bb65A\\u7ea7\\u666f\\u533a\\uff0c\\u96c6\\u81ea\\u7136\\u98ce\\u5149\\u4e0e\\u5782\\u9493\\u4e50\\u8da3\\u4e8e\\u4e00\\u4f53\\u3002\\u6e56\\u6c34\\u6e05\\u6f88\\uff0c\\u73af\\u5883\\u4f18\\u7f8e\\uff0c\\u662f\\u4f11\\u95f2\\u5782\\u9493\\u7684\\u7406\\u60f3\\u573a\\u6240\\u3002</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u5168\\u5e74\\u9002\\u5b9c\\uff0c\\u6625\\u590f\\u5b63\\u8282\\u6700\\u4f73</p>\\n                        <p><strong>\\u95e8\\u7968\\uff1a</strong>\\u9700\\u8d2d\\u4e70\\u666f\\u533a\\u95e8\\u7968</p>\\n                    </div>\\n\\n                    <div class=\\"location-card\\">\\n                        <h4>\\u957f\\u98ce\\u516c\\u56ed\\u94f6\\u9504\\u6e56</h4>\\n                        <p><strong>\\u4f4d\\u7f6e\\uff1a</strong>\\u666e\\u9640\\u533a\\u5927\\u6e21\\u6cb3\\u8def451\\u53f7</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u5e02\\u533a\\u5185\\u96be\\u5f97\\u7684\\u5927\\u578b\\u5c71\\u6c34\\u516c\\u56ed\\uff0c\\u94f6\\u9504\\u6e56\\u6c34\\u976214.3\\u4e07\\u5e73\\u65b9\\u7c73\\uff0c\\u4ea4\\u901a\\u4fbf\\u5229\\uff0c\\u9002\\u5408\\u5e02\\u533a\\u9493\\u53cb\\u3002</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u65e9\\u66686-10\\u70b9\\uff0c\\u508d\\u665a4-8\\u70b9</p>\\n                        <p><strong>\\u4ea4\\u901a\\uff1a</strong>\\u5730\\u94c