tle {\n            font-size: 1.3em;\n            opacity: 0.9;\n            margin-bottom: 30px;\n        }\n\n        .content {\n            padding: 50px 40px;\n        }\n\n        .section {\n            margin-bottom: 60px;\n            padding: 30px;\n            border-radius: 15px;\n            background: #fafafa;\n            border-left: 5px solid #667eea;\n        }\n\n        .section h2 {\n            color: #667eea;\n            font-size: 2.2em;\n            margin-bottom: 25px;\n            padding-bottom: 15px;\n            border-bottom: 2px solid #e0e0e0;\n            display: flex;\n            align-items: center;\n        }\n\n        .section h2::before {\n            content: \'🎣\';\n            margin-right: 15px;\n            font-size: 1.2em;\n        }\n\n        .section h3 {\n            color: #555;\n            font-size: 1.6em;\n            margin: 30px 0 20px 0;\n            padding-left: 20px;\n            border-left: 3px solid #667eea;\n        }\n\n        .section h4 {\n            color: #666;\n            font-size: 1.3em;\n            margin: 25px 0 15px 0;\n            font-weight: 600;\n        }\n\n        .section p {\n            margin-bottom: 20px;\n            text-align: justify;\n            font-size: 1.1em;\n            line-height: 1.8;\n        }\n\n        .image-container {\n            margin: 30px 0;\n            text-align: center;\n            border-radius: 15px;\n            overflow: hidden;\n            box-shadow: 0 8px 25px rgba(0,0,0,0.15);\n        }\n\n        .image-container img {\n            width: 100%;\n            height: auto;\n            display: block;\n            transition: transform 0.3s ease;\n        }\n\n        .image-container:hover img {\n            transform: scale(1.05);\n        }\n\n        .image-caption {\n            background: #f8f9fa;\n            padding: 15px;\n            font-style: italic;\n            color: #666;\n            border-top: 1px solid #e0e0e0