 2.2em;\\n            margin-bottom: 25px;\\n            padding-bottom: 15px;\\n            border-bottom: 2px solid #e0e0e0;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .section h2::before {\\n            content: \'\\ud83c\\udfa3\';\\n            margin-right: 15px;\\n            font-size: 1.2em;\\n        }\\n\\n        .section h3 {\\n            color: #555;\\n            font-size: 1.6em;\\n            margin: 30px 0 20px 0;\\n            padding-left: 20px;\\n            border-left: 3px solid #667eea;\\n        }\\n\\n        .section h4 {\\n            color: #666;\\n            font-size: 1.3em;\\n            margin: 25px 0 15px 0;\\n            font-weight: 600;\\n        }\\n\\n        .section p {\\n            margin-bottom: 20px;\\n            text-align: justify;\\n            font-size: 1.1em;\\n            line-height: 1.8;\\n        }\\n\\n        .image-container {\\n            margin: 30px 0;\\n            text-align: center;\\n            border-radius: 15px;\\n            overflow: hidden;\\n            box-shadow: 0 8px 25px rgba(0,0,0,0.15);\\n        }\\n\\n        .image-container img {\\n            width: 100%;\\n            height: auto;\\n            display: block;\\n            transition: transform 0.3s ease;\\n        }\\n\\n        .image-container:hover img {\\n            transform: scale(1.05);\\n        }\\n\\n        .image-caption {\\n            background: #f8f9fa;\\n            padding: 15px;\\n            font-style: italic;\\n            color: #666;\\n            border-top: 1px solid #e0e0e0;\\n        }\\n\\n        .location-grid {\\n            display: grid;\\n            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));\\n            gap: 30px;\\n            margin: 30px 0;\\n        }\\n\\n        .location-card {\\n            background: white;\\n            border-radius: 15px;\\n            padding: 25px;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\\n        }\\n\\n        .location-card:hover {\\n            transform: translateY(-5px);\\n            box-shadow: 0 10px 30px rgba(0,0,0,0.15);\\n        }\\n\\n        .location-card h4 {\\n            color: #667eea;\\n            font-size: 1.4em;\\n            margin-bottom: 15px;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .location-card h4::before {\\n            content: \'\\ud83d\\udccd\';\\n            margin-right: 10px;\\n        }\\n\\n        .tips-box {\\n            background: linear-gradient(135deg, #ffeaa7 0%, #fab1a0 100%);\\n            border-radius: 15px;\\n            padding: 25px;\\n            margin: 30px 0;\\n            border-left: 5px solid #e17055;\\n        }\\n\\n        .tips-box h4 {\\n            color: #d63031;\\n            margin-bottom: 15px;\\n            font-size: 1.3em;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .tips-box h4::before {\\n            content: \'\\ud83d\\udca1\';\\n            margin-right: 10px;\\n        }\\n\\n        .warning-box {\\n            background: linear-gradient(135deg, #ff7675 0%, #fd79a8 100%);\\n            color: white;\\n            border-radius: 15px;\\n            padding: 25px;\\n            margin: 30px 0;\\n            border-left: 5px solid #e84393;\\n        }\\n\\n        .warning-box h4 {\\n            margin-bottom: 15px;\\n            font-size: 1.3em;\\n            display: flex;\\n            align-items: center;\\n        }\\n\\n        .warning-box h4::before {\\n            content: \'\\u26a0\\ufe0f\';\\n            margin-right: 10px;\\n        }\\n\\n        .equipment-grid {\\n            display: grid;\\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\\n            gap: 20px;\\n            margin: 30px 0;\\n        }\\n\\n        .equipment-item {\\n            background: white;\\n            border-radius: 10px;\\n            padding: 20px;\\n            text-align: center;\\n            box-shadow: 0 3px 15px rgba(0,0,0,0.1);\\n            transition: transform 0.3s ease;\\n        }\\n\\n        .equipment-item:hover {\\n            transform: translateY(-3px);\\n        }\\n\\n        .equipment-item h5 {\\n            color: #667eea;\\n            margin-bottom: 10px;\\n            font-size: 1.2em;\\n        }\\n\\n        .season-timeline {\\n            display: flex;\\n            justify-content: space-between;\\n            margin: 30px 0;\\n            flex-wrap: wrap;\\n            gap: 20px;\\n        }\\n\\n        .season-item {\\n            flex: 1;\\n            min-width: 200px;\\n            background: white;\\n            border-radius: 15px;\\n            padding: 25px;\\n            text-align: center;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n            position: relative;\\n            overflow: hidden;\\n        }\\n\\n        .season-item::before {\\n            content: \'\';\\n            position: absolute;\\n            top: 0;\\n            left: 0;\\n            right: 0;\\n            height: 5px;\\n            background: linear-gradient(90deg, #667eea, #764ba2);\\n        }\\n\\n        .season-item h4 {\\n            color: #667eea;\\n            margin-bottom: 15px;\\n            font-size: 1.3em;\\n        }\\n\\n        .fish-gallery {\\n            display: grid;\\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\\n            gap: 20px;\\n            margin: 30px 0;\\n        }\\n\\n        .fish-card {\\n            background: white;\\n            border-radius: 15px;\\n            overflow: hidden;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n            transition: transform 0.3s ease;\\n        }\\n\\n        .fish-card:hover {\\n            transform: scale(1.05);\\n        }\\n\\n        .fish-card img {\\n            width: 100%;\\n            height: 150px;\\n            object-fit: cover;\\n        }\\n\\n        .fish-card-content {\\n            padding: 15px;\\n        }\\n\\n        .fish-card h5 {\\n            color: #667eea;\\n            margin-bottom: 10px;\\n            font-size: 1.1em;\\n        }\\n\\n        .footer {\\n            background: #2d3436;\\n            color: white;\\n            padding: 40px;\\n            text-align: center;\\n        }\\n\\n        .footer h3 {\\n            margin-bottom: 20px;\\n            color: #74b9ff;\\n        }\\n\\n        @media (max-width: 768px) {\\n            .header h1 {\\n                font-size: 2.5em;\\n            }\\n            \\n            .content {\\n                padding: 30px 20px;\\n            }\\n            \\n            .section {\\n                padding: 20px;\\n            }\\n            \\n            .location-grid {\\n                grid-template-columns: 1fr;\\n            }\\n            \\n            .season-timeline {\\n                flex-direction: column;\\n            }\\n        }\\n\\n        .table-container {\\n            overflow-x: auto;\\n            margin: 30px 0;\\n            border-radius: 15px;\\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\\n        }\\n\\n        table {\\n            width: 100%;\\n            border-collapse: collapse;\\n            background: white;\\n        }\\n\\n        th, td {\\n            padding: 15px;\\n            text-align: left;\\n            border-bottom: 1px solid #e0e0e0;\\n        }\\n\\n        th {\\n            background: #667eea;\\n            color: white;\\n            font-weight: 600;\\n        }\\n\\n        tr:hover {\\n            background: #f8f9fa;\\n        }\\n\\n        .highlight {\\n            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);\\n            padding: 20px;\\n            border-radius: 15px;\\n            margin: 20px 0;\\n            border-left: 5px solid #00b894;\\n        }\\n    </style>\\n</head>\\n<body>\\n    <div class=\\"container\\">\\n        <header class=\\"header\\">\\n            <div class=\\"header-content\\">\\n                <h1>\\u5782\\u9493\\u4e50\\u8da3\\uff5c\\u4e0a\\u6d77\\u91ce\\u9493\\u5b8c\\u5168\\u6307\\u5357</h1>\\n                <p class=\\"subtitle\\">\\u63a2\\u7d22\\u9b54\\u90fd\\u6c34\\u57df\\uff0c\\u4eab\\u53d7\\u5782\\u9493\\u4e50\\u8da3\\u7684\\u7ec8\\u6781\\u6307\\u5357</p>\\n            </div>\\n        </header>\\n\\n        <div class=\\"content\\">\\n            <!-- \\u5f15\\u8a00\\u90e8\\u5206 -->\\n            <div class=\\"section\\">\\n                <h2>\\u5f15\\u8a00\\uff1a\\u9b54\\u90fd\\u7684\\u5782\\u9493\\u9b45\\u529b</h2>\\n                <div class=\\"image-container\\">\\n                    <img src=\\"https://images.unsplash.com/photo-1559827260-dc66d52bef19?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80\\" alt=\\"\\u4e0a\\u6d77\\u9ec4\\u6d66\\u6c5f\\u7554\\u9493\\u9c7c\\">\\n                    <div class=\\"image-caption\\">\\u9ec4\\u6d66\\u6c5f\\u7554\\u7684\\u5782\\u9493\\u98ce\\u5149</div>\\n                </div>\\n                <p>\\u4e0a\\u6d77\\uff0c\\u8fd9\\u5ea7\\u56fd\\u9645\\u5316\\u5927\\u90fd\\u5e02\\uff0c\\u4e0d\\u4ec5\\u4ee5\\u5176\\u7e41\\u534e\\u7684\\u5546\\u4e1a\\u533a\\u548c\\u6469\\u5929\\u5927\\u697c\\u95fb\\u540d\\uff0c\\u66f4\\u62e5\\u6709\\u4e30\\u5bcc\\u7684\\u6c34\\u57df\\u8d44\\u6e90\\uff0c\\u4e3a\\u5782\\u9493\\u7231\\u597d\\u8005\\u63d0\\u4f9b\\u4e86\\u7edd\\u4f73\\u7684\\u91ce\\u9493\\u73af\\u5883\\u3002\\u4ece\\u5d07\\u660e\\u5c9b\\u7684\\u81ea\\u7136\\u6e7f\\u5730\\u5230\\u5e02\\u533a\\u7684\\u516c\\u56ed\\u6e56\\u6cca\\uff0c\\u4ece\\u9ec4\\u6d66\\u6c5f\\u7684\\u652f\\u6d41\\u5230\\u90ca\\u533a\\u7684\\u6c34\\u5e93\\uff0c\\u4e0a\\u6d77\\u7684\\u91ce\\u9493\\u8d44\\u6e90\\u53ef\\u8c13\\u5f97\\u5929\\u72ec\\u539a\\u3002</p>\\n                <p>\\u672c\\u6307\\u5357\\u5c06\\u4e3a\\u60a8\\u8be6\\u7ec6\\u4ecb\\u7ecd\\u4e0a\\u6d77\\u5730\\u533a\\u6700\\u4f73\\u7684\\u91ce\\u9493\\u5730\\u70b9\\u3001\\u76f8\\u5173\\u6cd5\\u89c4\\u3001\\u9493\\u9c7c\\u6280\\u5de7\\u4ee5\\u53ca\\u88c5\\u5907\\u9009\\u62e9\\uff0c\\u5e2e\\u52a9\\u60a8\\u5728\\u8fd9\\u5ea7\\u73b0\\u4ee3\\u5316\\u90fd\\u5e02\\u4e2d\\u627e\\u5230\\u5c5e\\u4e8e\\u81ea\\u5df1\\u7684\\u5782\\u9493\\u4e50\\u56ed\\u3002\\u65e0\\u8bba\\u60a8\\u662f\\u521d\\u5b66\\u8005\\u8fd8\\u662f\\u8d44\\u6df1\\u9493\\u53cb\\uff0c\\u90fd\\u80fd\\u5728\\u8fd9\\u91cc\\u627e\\u5230\\u6709\\u4ef7\\u503c\\u7684\\u4fe1\\u606f\\u548c\\u5b9e\\u7528\\u7684\\u5efa\\u8bae\\u3002</p>\\n            </div>\\n\\n            <!-- \\u4e0a\\u6d77\\u91ce\\u9493\\u5730\\u70b9\\u63a8\\u8350 -->\\n            <div class=\\"section\\">\\n                <h2>\\u4e0a\\u6d77\\u5341\\u5927\\u91ce\\u9493\\u80dc\\u5730</h2>\\n                <div class=\\"image-container\\">\\n                    <img src=\\"https://images.unsplash.com/photo-1578662996442-48f60103fc96?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80\\" alt=\\"\\u4e0a\\u6d77\\u5317\\u6e56\\u98ce\\u666f\\">\\n                    <div class=\\"image-caption\\">\\u4e0a\\u6d77\\u5317\\u6e56 - \\u91ce\\u9493\\u7231\\u597d\\u8005\\u7684\\u5929\\u5802</div>\\n                </div>\\n                \\n                <div class=\\"location-grid\\">\\n                    <div class=\\"location-card\\">\\n                        <h4>\\u4e0a\\u6d77\\u5317\\u6e56</h4>\\n                        <p><strong>\\u4f4d\\u7f6e\\uff1a</strong>\\u5d07\\u660e\\u4e2d\\u90e8\\u5317\\u4fa7</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u6c34\\u57df\\u9762\\u79ef\\u7ea61.2\\u4e07\\u4ea9\\uff0c\\u76f8\\u5f53\\u4e8e2\\u4e2a\\u897f\\u6e56\\u5927\\u5c0f\\uff0c\\u662f\\u4e0a\\u6d77\\u8f83\\u5927\\u7684\\u4eba\\u5de5\\u6e56\\u3002\\u9c7c\\u7c7b\\u8d44\\u6e90\\u4e30\\u5bcc\\uff0c\\u4e3b\\u8981\\u6709\\u9ca4\\u9c7c\\u3001\\u8349\\u9c7c\\u3001\\u9ca2\\u9c7c\\u3001\\u9752\\u9c7c\\u7b49\\u3002</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u6625\\u79cb\\u4e24\\u5b63\\uff0c\\u4e0a\\u534810\\u70b9\\u81f3\\u4e0b\\u53484\\u70b9</p>\\n                        <p><strong>\\u4ea4\\u901a\\uff1a</strong>\\u5730\\u94c1+\\u516c\\u4ea4\\uff0c\\u5efa\\u8bae\\u81ea\\u9a7e\\u524d\\u5f80</p>\\n                    </div>\\n\\n                    <div class=\\"location-card\\">\\n                        <h4>\\u660e\\u73e0\\u6e56\\u00b7\\u897f\\u6c99\\u6e7f\\u5730\\u666f\\u533a</h4>\\n                        <p><strong>\\u4f4d\\u7f6e\\uff1a</strong>\\u5d07\\u660e\\u5c9b\\u897f\\u90e8</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u56fd\\u5bb65A\\u7ea7\\u666f\\u533a\\uff0c\\u96c6\\u81ea\\u7136\\u98ce\\u5149\\u4e0e\\u5782\\u9493\\u4e50\\u8da3\\u4e8e\\u4e00\\u4f53\\u3002\\u6e56\\u6c34\\u6e05\\u6f88\\uff0c\\u73af\\u5883\\u4f18\\u7f8e\\uff0c\\u662f\\u4f11\\u95f2\\u5782\\u9493\\u7684\\u7406\\u60f3\\u573a\\u6240\\u3002</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u5168\\u5e74\\u9002\\u5b9c\\uff0c\\u6625\\u590f\\u5b63\\u8282\\u6700\\u4f73</p>\\n                        <p><strong>\\u95e8\\u7968\\uff1a</strong>\\u9700\\u8d2d\\u4e70\\u666f\\u533a\\u95e8\\u7968</p>\\n                    </div>\\n\\n                    <div class=\\"location-card\\">\\n                        <h4>\\u957f\\u98ce\\u516c\\u56ed\\u94f6\\u9504\\u6e56</h4>\\n                        <p><strong>\\u4f4d\\u7f6e\\uff1a</strong>\\u666e\\u9640\\u533a\\u5927\\u6e21\\u6cb3\\u8def451\\u53f7</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u5e02\\u533a\\u5185\\u96be\\u5f97\\u7684\\u5927\\u578b\\u5c71\\u6c34\\u516c\\u56ed\\uff0c\\u94f6\\u9504\\u6e56\\u6c34\\u976214.3\\u4e07\\u5e73\\u65b9\\u7c73\\uff0c\\u4ea4\\u901a\\u4fbf\\u5229\\uff0c\\u9002\\u5408\\u5e02\\u533a\\u9493\\u53cb\\u3002</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u65e9\\u66686-10\\u70b9\\uff0c\\u508d\\u665a4-8\\u70b9</p>\\n                        <p><strong>\\u4ea4\\u901a\\uff1a</strong>\\u5730\\u94c12\\u53f7\\u7ebf\\u4e2d\\u5c71\\u516c\\u56ed\\u7ad9</p>\\n                    </div>\\n\\n                    <div class=\\"location-card\\">\\n                        <h4>\\u5927\\u5343\\u751f\\u6001\\u5e84\\u56ed</h4>\\n                        <p><strong>\\u4f4d\\u7f6e\\uff1a</strong>\\u6731\\u5bb6\\u89d2\\u53e4\\u9547\\u4fa7\\u7554</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u4f9d\\u6dc0\\u5c71\\u6e56\\u800c\\u5efa\\uff0c\\u5360\\u5730600\\u4f59\\u4ea9\\uff0c\\u6e56\\u9762\\u6c34\\u57df\\u8fbe400\\u4ea9\\u3002\\u751f\\u517b\\u7740\\u9cab\\u3001\\u9ca4\\u3001\\u9752\\u3001\\u8349\\u3001\\u9ca2\\u3001\\u9cd9\\u7b49\\u9c7c\\u7c7b\\u8fbe\\u767e\\u4e07\\u65a4\\u3002</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u5168\\u5929\\u5019\\uff0c\\u6625\\u79cb\\u5b63\\u8282\\u6700\\u4f73</p>\\n                        <p><strong>\\u7279\\u8272\\u670d\\u52a1\\uff1a</strong>\\u63d0\\u4f9b\\u9493\\u5177\\u79df\\u8d41\\u548c\\u9910\\u996e\\u670d\\u52a1</p>\\n                    </div>\\n\\n                    <div class=\\"location-card\\">\\n                        <h4>\\u6ef4\\u6c34\\u6e56\\u6c34\\u5229\\u98ce\\u666f\\u533a</h4>\\n                        <p><strong>\\u4f4d\\u7f6e\\uff1a</strong>\\u6d66\\u4e1c\\u65b0\\u533a\\u4e34\\u6e2f\\u65b0\\u57ce</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u5448\\u6b63\\u5706\\u5f62\\uff0c\\u76f4\\u5f842.6\\u516c\\u91cc\\uff0c\\u603b\\u9762\\u79ef5.56\\u5e73\\u65b9\\u516c\\u91cc\\u3002\\u56fd\\u5bb6\\u7ea7\\u6c34\\u5229\\u98ce\\u666f\\u533a\\uff0c\\u73af\\u5883\\u4f18\\u7f8e\\u3002</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u6625\\u79cb\\u4e24\\u5b63\\uff0c\\u907f\\u5f00\\u5927\\u98ce\\u5929\\u6c14</p>\\n                        <p><strong>\\u4ea4\\u901a\\uff1a</strong>\\u5730\\u94c116\\u53f7\\u7ebf\\u6ef4\\u6c34\\u6e56\\u7ad9</p>\\n                    </div>\\n\\n                    <div class=\\"location-card\\">\\n                        <h4>\\u897f\\u90e8\\u6e14\\u6751</h4>\\n                        <p><strong>\\u4f4d\\u7f6e\\uff1a</strong>\\u677e\\u6c5f\\u533a\\u5c0f\\u6606\\u5c71\\u4e1c\\u90bb</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u56fd\\u5bb6\\u7ea7\\u6c34\\u4ea7\\u826f\\u79cd\\u573a\\uff0c\\u4e09\\u9762\\u73af\\u6c34\\u3002\\u4f9b\\u5782\\u9493\\u7684\\u9c7c\\u90fd\\u662f\\u7ecf\\u8fc7\\u7cbe\\u5fc3\\u9009\\u80b2\\u3001\\u751f\\u6001\\u517b\\u6b96\\u7684\\u9c7c\\u4e2d\\u7cbe\\u54c1\\uff0c\\u5305\\u62ec\\u5e02\\u573a\\u4e0a\\u5f88\\u5c11\\u89c1\\u7684\\u4e00\\u65a4\\u534a\\u7684\\u9cab\\u9c7c\\u3002</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u5168\\u5e74\\u9002\\u5b9c\\uff0c\\u6625\\u590f\\u5b63\\u8282\\u9c7c\\u7c7b\\u6d3b\\u8dc3</p>\\n                        <p><strong>\\u7279\\u8272\\uff1a</strong>\\u53ef\\u4f53\\u9a8c\\u519c\\u5bb6\\u751f\\u6d3b</p>\\n                    </div>\\n                </div>\\n\\n                <div class=\\"image-container\\">\\n                    <img src=\\"https://images.unsplash.com/photo-1551698618-1dfe5d97d256?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80\\" alt=\\"\\u6ee8\\u6d77\\u68ee\\u6797\\u516c\\u56ed\\">\\n                    <div class=\\"image-caption\\">\\u6ee8\\u6d77\\u68ee\\u6797\\u516c\\u56ed - \\u57ce\\u5e02\\u4e2d\\u7684\\u81ea\\u7136\\u5782\\u9493\\u73af\\u5883</div>\\n                </div>\\n            </div>\\n\\n            <!-- \\u9493\\u9c7c\\u6cd5\\u89c4\\u4e0e\\u6ce8\\u610f\\u4e8b\\u9879 -->\\n            <div class=\\"section\\">\\n                <h2>\\u9493\\u9c7c\\u6cd5\\u89c4\\u4e0e\\u6ce8\\u610f\\u4e8b\\u9879</h2>\\n                <div class=\\"warning-box\\">\\n                    <h4>\\u91cd\\u8981\\u6cd5\\u89c4\\u63d0\\u9192</h4>\\n                    <p>\\u6839\\u636e\\u4e0a\\u6d77\\u5e02\\u519c\\u4e1a\\u519c\\u6751\\u59d4\\u5458\\u4f1a