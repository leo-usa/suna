.add_slide(two_content_layout)\\nif slide.shapes.title:\\n    slide.shapes.title.text = \'n8n\\u4e0eMCP\\u96c6\\u6210\\u67b6\\u6784\'\\n\\nplaceholders = [p for p in slide.placeholders if p.placeholder_format.type in [2, 3]]\\nif len(placeholders) >= 2:\\n    placeholders[0].text = \'\'\'\\u96c6\\u6210\\u65b9\\u5f0f\\u4e00\\uff1an8n\\u4f5c\\u4e3aMCP\\u670d\\u52a1\\u5668\\n\\u2022 \\u67b6\\u6784\\u8bbe\\u8ba1\\n    \\u25cb n8n\\u5de5\\u4f5c\\u6d41\\u66b4\\u9732\\u4e3aMCP\\u670d\\u52a1\\n    \\u25cb AI\\u667a\\u80fd\\u4f53\\u4f5c\\u4e3aMCP\\u5ba2\\u6237\\u7aef\\n    \\u25cb \\u6807\\u51c6\\u5316\\u63a5\\u53e3\\u8c03\\u7528\\n    \\u25cb \\u7edf\\u4e00\\u9519\\u8bef\\u5904\\u7406\\u673a\\u5236\\n\\u2022 \\u5b9e\\u73b0\\u6b65\\u9aa4\\n    \\u25cb \\u6dfb\\u52a0MCP\\u670d\\u52a1\\u5668\\u89e6\\u53d1\\u5668\\n    \\u25cb \\u914d\\u7f6e\\u5de5\\u4f5c\\u6d41\\u4e1a\\u52a1\\u903b\\u8f91\\n    \\u25cb \\u5b9a\\u4e49\\u8f93\\u5165\\u8f93\\u51fa\\u683c\\u5f0f\\n    \\u25cb \\u6fc0\\u6d3b\\u670d\\u52a1\\u76d1\\u542c\\n\\u2022 \\u5e94\\u7528\\u573a\\u666f\\n    \\u25cb \\u6570\\u636e\\u5904\\u7406\\u670d\\u52a1\\n    \\u25cb \\u4e1a\\u52a1\\u6d41\\u7a0b\\u81ea\\u52a8\\u5316\\n    \\u25cb \\u7cfb\\u7edf\\u96c6\\u6210\\u7f16\\u6392\\n    \\u25cb \\u8ba1\\u7b97\\u670d\\u52a1\\u63d0\\u4f9b\'\'\'\\n    \\n    placeholders[1].text = \'\'\'\\u96c6\\u6210\\u65b9\\u5f0f\\u4e8c\\uff1an8n\\u4f5c\\u4e3aMCP\\u5ba2\\u6237\\u7aef\\n\\u2022 \\u67b6\\u6784\\u8bbe\\u8ba1\\n    \\u25cb n8n\\u8fde\\u63a5\\u5916\\u90e8MCP\\u670d\\u52a1\\u5668\\n    \\u25cb \\u8c03\\u7528\\u7b2c\\u4e09\\u65b9AI\\u5de5\\u5177\\n    \\u25cb \\u6269\\u5c55\\u5de5\\u4f5c\\u6d41\\u80fd\\u529b\\n    \\u25cb \\u7edf\\u4e00\\u670d\\u52a1\\u7ba1\\u7406\\n\\u2022 \\u5b9e\\u73b0\\u6b65\\u9aa4\\n    \\u25cb \\u5b89\\u88c5MCP\\u5ba2\\u6237\\u7aef\\u8282\\u70b9\\n    \\u25cb \\u914d\\u7f6e\\u670d\\u52a1\\u5668\\u8fde\\u63a5\\n    \\u25cb \\u8bbe\\u7f6e\\u8ba4\\u8bc1\\u53c2\\u6570\\n    \\u25cb \\u6d4b\\u8bd5\\u8fde\\u63a5\\u72b6\\u