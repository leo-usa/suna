to_remove = list(range(1, len(ppt.slides)))\\nfor i in reversed(slides_to_remove):\\n    rId = ppt.slides._sldIdLst[i].rId\\n    ppt.part.drop_rel(rId)\\n    del ppt.slides._sldIdLst[i]\\n\\n# Update title slide\\ntitle_slide = ppt.slides[0]\\nfor shape in title_slide.shapes:\\n    if hasattr(shape, \'text\'):\\n        if \'\\u7b2c4\\u8bb2\' in shape.text or \'\\u6700\\u5f3a\\u5927\\u7684\\u51e0\\u4e2a\\u7f16\\u7a0b\\u667a\\u80fd\\u4f53\' in shape.text:\\n            shape.text = \'\\u7b2c5\\u8bb2\\uff1a\\u96f6\\u4ee3\\u7801\\u7528n8n\\u548cMCP\\u5efa\\u7acb\\u5168\\u81ea\\u52a8\\u7684\\u667a\\u80fd\\u4f53\\\\\\\\n\\u96f6\\u4ee3\\u7801\\u667a\\u80fd\\u81ea\\u52a8\\u5316\\u5b9e\\u73b0\\u65b9\\u6848\'\\n        elif \'DR. PANG\' in shape.text:\\n            shape.text = \'DR. PANG \\u5e9e\\u535a\\u58eb\\\\\\\\nAI\\u667a\\u80fd\\u4f53\\u8bfe\\u7a0b\\u7cfb\\u5217\'\\n\\nprint(\'Title slide updated\')\\n\\n# Find the Two Content layout (TWO_OBJECTS)\\ntwo_content_layout = None\\nfor i, layout in enumerate(ppt.slide_layouts):\\n    if \'TWO\' in layout.name.upper() or \'OBJECT\' in layout.name.upper():\\n        two_content_layout = layout\\n        print(f\'Using layout {i}: {layout.name}\')\\n        break\\n\\nif two_content_layout is None:\\n    two_content_layout = ppt.slide_layouts[1]  # Fallback\\n    print(\'Using fallback layout\')\\n\\n# Slide 2: Course Overview\\nslide = ppt.slides.add_slide(two_content_layout)\\nif slide.shapes.title:\\n    slide.shapes.title.text = \'\\u8bfe\\u7a0b\\u6982\\u89c8\\u4e0e\\u5b66\\u4e60\\u76ee\\u6807\'\\n\\n# Set content for left and right placeholders\\nplaceholders = [p for p in slide.placeholders if p.placeholder_format.type in [2, 3]]\\nif len(placeholders) >= 2:\\n    # Left content\\n    placeholders[0].text = \'\'\'\\u672c\\u8bb2\\u6838\\u5fc3\\u5185\\u5bb9\\uff1a\\n\\u2022 n8n\\u5de5\\u4f5c\\u6d41\\u81ea\\u52a8\\u5316\\u5e73\\u53f0\\n    \\u25cb \\u53ef\\u89c6\\u5316\\u7f16\\u8f91\\u5668\\u4f7f\\u7528\\n    \\u25cb 400+\\u96c6\\u6210\\u8fde\\u63a5\\u5668\\n    \\u25cb AI\\u539f\\u751f\\u67b6\\u6784\\u7279\\u6027\\n\\u2022 MCP\\u6a21\\u578b\\u4e0a\\u4e0b\\u6587\\u534f\\u8bae\\n    \\u25cb \\u534f\\u8bae\\u67b6\\u6784\\u4e0e\\u539f\\u7406\\n    \\u25cb \\u4e09\\u5c42\\u7ec4\\u4ef6\\u8bbe\\u8ba1\\n    \\u25cb \\u6807\\u51c6\\u5316\\u96c6\\u6210\\u65b9\\u6848\\n\\u2022 \\u96f6\\u4ee3\\u7801\\u667a\\u80fd\\u4f53\\u6784\\u5efa\\n    \\u25cb \\u67b6\\u6784\\u8bbe\\u8ba1\\u65b9\\u6cd5\\n    \\u25cb \\u5b9e\\u6218\\u5f00\\u53d1\\u6d41\\u7a0b\\n    \\u25cb \\u90e8\\u7f72\\u8fd0\\u7ef4\\u7b56\\u7565\'\'\'\\n    \\n    # Right content\\n    placeholders[1].text = \'\'\'\\u5b66\\u4e60\\u76ee\\u6807\\u4e0e\\u6536\\u83b7\\uff1a\\n\\u2022 \\u6280\\u80fd\\u638c\\u63e1\\n    \\u25cb n8n\\u5e73\\u53f0\\u6838\\u5fc3\\u529f\\u80fd\\n    \\u25cb MCP\\u534f\\u8bae\\u96c6\\u6210\\u6280\\u672f\\n    \\u25cb \\u96f6\\u4ee3\\u7801\\u5f00\\u53d1\\u65b9\\u6cd5\\n\\u2022 \\u5b9e\\u6218\\u80fd\\u529b\\n    \\u25cb \\u590d\\u6742\\u4e1a\\u52a1\\u6d41\\u7a0b\\u81ea\\u52a8\\u5316\\n    \\u25cb AI\\u667a\\u80fd\\u4f53\\u7cfb\\u7edf\\u6784\\u5efa\\n    \\u25cb \\u4f01\\u4e1a\\u7ea7\\u89e3\\u51b3\\u65b9\\u6848\\u8bbe\\u8ba1\\n\\u2022 \\u804c\\u4e1a\\u53d1\\u5c55\\n    \\u25cb AI\\u81ea\\u52a8\\u5316\\u4e13\\u4e1a\\u6280\\u80fd\\n    \\u25cb \\u524d\\u6cbf\\u6280\\u672f\\u5e94\\u7528\\u80fd\\u529b\\n    \\u25cb \\u6570\\u5b57\\u5316\\u8f6c\\u578b\\u9886\\u5bfc\\u529b\'\'\'\\n\\nprint(\'Slide 2 created\')\\n\\n# Slide 3: n8n Platform Deep Dive\\nslide = ppt.slides.add_slide(two_content_layout)\\nif slide.shapes.title:\\n    slide.shapes.title.text = \'n8n\\u5e73\\u53f0\\u6df1\\u5ea6\\u89e3\\u6790\'\\n\\nplaceholders = [p for p in slide.placeholders if p.placeholder_format.type in [2, 3]]\\nif len(placeholders) >= 2:\\n    placeholders[0].text = \'\'\'\\u5e73\\u53f0\\u6838\\u5fc3\\u7279\\u6027\\uff1a\\n\\u2022 \\u6280\\u672f\\u67b6\\u6784\\n    \\u25cb \\u5f00\\u6e90\\u514d\\u8d39\\uff0873.7k+ GitHub\\u661f\\u6807\\uff09