laceholders[0].text_frame, left_content)\\n    \\n    right_content = [\\n        (\'\\u884c\\u4e1a\\u5e94\\u7528\\uff1a\', 0),\\n        (\'\\u533b\\u7597\\uff1a\\u4e34\\u5e8a\\u51b3\\u7b56\\u652f\\u6301\', 1),\\n        (\'\\u91d1\\u878d\\uff1a\\u667a\\u80fd\\u98ce\\u63a7\', 1),\\n        (\'\\u5236\\u9020\\uff1a\\u9884\\u6d4b\\u6027\\u7ef4\\u62a4\', 1),\\n        (\'\\u6559\\u80b2\\uff1a\\u4e2a\\u6027\\u5316\\u5b66\\u4e60\', 1),\\n        (\'\\u96f6\\u552e\\uff1a\\u52a8\\u6001\\u5b9a\\u4ef7\', 1),\\n        (\'\\u653f\\u52a1\\uff1a\\u667a\\u80fd\\u5ba1\\u6279\', 1)\\n    ]\\n    add_formatted_text_no_empty_first(placeholders[1].text_frame, right_content)\\n\\nprint(\'Slide 10 created\')\\n\\n# Slide 11: Action Plan\\nslide = ppt.slides.add_slide(two_content_layout)\\nif slide.shapes.title:\\n    slide.shapes.title.text = \'\\u884c\\u52a8\\u8ba1\\u5212\'\\n\\nplaceholders = [p for p in slide.placeholders if p.placeholder_format.type in [2, 3]]\\nif len(placeholders) >= 2:\\n    left_content = [\\n        (\'\\u7acb\\u5373\\u5f00\\u59cb\\uff08\\u7b2c1\\u5468\\uff09\\uff1a\', 0),\\n        (\'\\u5b89\\u88c5n8n\\u5f00\\u53d1\\u73af\\u5883\', 1),\\n        (\'\\u5b8c\\u6210\\u57fa\\u7840\\u7ec3\\u4e60\', 1),\\n        (\'\\u6d4b\\u8bd5MCP\\u8fde\\u63a5\', 1),\\n        (\'\\u719f\\u6089\\u5e73\\u53f0\\u64cd\\u4f5c\', 1),\\n        (\'\\u52a0\\u5165\\u5b98\\u65b9\\u793e\\u533a\', 1),\\n        (\'\\u5173\\u6ce8\\u6280\\u672f\\u52a8\\u6001\', 1)\\n    ]\\n    add_formatted_text_no_empty_first(placeholders[0].text_frame, left_content)\\n    \\n    right_content = [\\n        (\'\\u6df1\\u5165\\u5b9e\\u8df5\\uff08\\u7b2c2-4\\u5468\\uff09\\uff1a\', 0),\\n        (\'\\u6784\\u5efaAI\\u667a\\u80fd\\u4f53\\u9879\\u76ee\', 1),\\n        (\'\\u96c6\\u6210\\u4e1a\\u52a1\\u573a\\u666f\', 1),\\n        (\'\\u4f18\\u5316\\u5b89\\u5168\\u6027\\u80fd\', 1),\\n        (\'\\u90e8\\u7f72\\u751f\\u4ea7\\u73af\\u5883\', 1),\\n        (\'\\u6536\\u96c6\\u53cd\\u9988\\u6539\\u8fdb\', 1),\\n