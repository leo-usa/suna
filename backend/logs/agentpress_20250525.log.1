.slide_layouts[1]\\n\\ndef add_formatted_text_no_empty_first(text_frame, content_lines):\\n    \'\'\'Add formatted text starting from first line (no empty first line)\'\'\'\\n    text_frame.clear()\\n    \\n    # Add first paragraph without creating empty line\\n    if content_lines:\\n        first_line = content_lines[0]\\n        if isinstance(first_line, tuple):\\n            text, level = first_line\\n        else:\\n            text, level = first_line, 0\\n        \\n        # Use the existing first paragraph instead of adding new one\\n        p = text_frame.paragraphs[0]\\n        p.text = text\\n        p.level = level\\n        \\n        # Add remaining paragraphs\\n        for line_data in content_lines[1:]:\\n            if isinstance(line_data, tuple):\\n                text, level = line_data\\n            else:\\n                text, level = line_data, 0\\n                \\n            p = text_frame.add_paragraph()\\n            p.text = text\\n            p.level = level\\n\\n# Slide 2: Course Overview\\nslide = ppt.slides.add_slide(two_content_layout)\\nif slide.shapes.title:\\n    slide.shapes.title.text = \'\\u8bfe\\u7a0b\\u6982\\u89c8\'\\n\\nplaceholders = [p for p in slide.placeholders if p.placeholder_format.type in [2, 3]]\\nif len(placeholders) >= 2:\\n    left_content = [\\n        (\'\\u672c\\u8bb2\\u6838\\u5fc3\\u5185\\u5bb9\\uff1a\', 0),\\n        (\'n8n\\u5de5\\u4f5c\\u6d41\\u81ea\\u52a8\\u5316\\u5e73\\u53f0\', 1),\\n        (\'MCP\\u6a21\\u578b\\u4e0a\\u4e0b\\u6587\\u534f\\u8bae\', 1),\\n        (\'\\u96f6\\u4ee3\\u7801AI\\u667a\\u80fd\\u4f53\\u6784\\u5efa\', 1),\\n        (\'\\u96c6\\u6210\\u5b9e\\u6218\\u6f14\\u7ec3\', 1),\\n        (\'\\u4f01\\u4e1a\\u7ea7\\u5e94\\u7528\\u6848\\u4f8b\', 1),\\n        (\'\\u90e8\\u7f72\\u6700\\u4f73\\u5b9e\\u8df5\', 1)\\n    ]\\n    add_formatted_text_no_empty_first(placeholders[0].text_frame, left_content)\\n    \\n    right_content = [\\n        (\'\\u5b66\\u4e60\\u76ee\\u6807\\uff1a\', 0),\\n 