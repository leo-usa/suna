2025-05-25 13:56:56,207 - agentpress - DEBUG - response_processor.py:1011 - Created tool call: {'function_name': 'execute_command', 'xml_tag_name': 'execute-command', 'arguments': {'command': 'cat > unsplash_image_search.py << \'EOF\'\nimport requests\nimport json\nfrom typing import List, Dict, Optional\n\nclass UnsplashImageSearch:\n    def __init__(self, access_key: str):\n        """\n        初始化Unsplash API客户端\n        \n        Args:\n            access_key: Unsplash API访问密钥\n        """\n        self.access_key = access_key\n        self.base_url = "https://api.unsplash.com"\n        self.headers = {\n            "Authorization": f"Client-ID {access_key}",\n            "Accept-Version": "v1"\n        }\n    \n    def search_photos(self, \n                     query: str, \n                     per_page: int = 10, \n                     page: int = 1,\n                     orientation: str = "landscape",\n                     order_by: str = "relevant") -> Dict:\n        """\n        搜索图片\n        \n        Args:\n            query: 搜索关键词\n            per_page: 每页返回的图片数量 (1-30)\n            page: 页码\n            orientation: 图片方向 ("landscape", "portrait", "squarish")\n            order_by: 排序方式 ("relevant", "latest")\n            \n        Returns:\n            包含搜索结果的字典\n        """\n        url = f"{self.base_url}/search/photos"\n        params = {\n            "query": query,\n            "per_page": per_page,\n            "page": page,\n            "orientation": orientation,\n            "order_by": order_by\n        }\n        \n        try:\n            response = requests.get(url, headers=self.headers, params=params)\n            response.raise_for_status()\n            return response.json()\n        except requests.exceptions.RequestException as e:\n            print(f"API请求错误: {e}")\n            return {}\n    \n    def get_image_urls(self, \n                      query: str, \n                      count: int = 5,\n                      size: str = "regular") -> List[Dict[str, str]]:\n        """\n        获取图片URL列表\n        \n        Args:\n            query: 搜索关键词\n            count: 返回图片数量\n            size: 图片尺寸 ("thumb", "small", "regular", "full", "raw")\n            \n        Returns:\n            包含图片信息的列表\n        """\n        results = self.search_photos(query, per_page=count)\n        \n        if not results or "results" not in results:\n            return []\n        \n        images = []\n        for photo in results["results"]:\n            image_info = {\n                "id": photo["id"],\n                "description": photo.get("description") or photo.get("alt_description", ""),\n                "url": photo["urls"][size],\n                "download_url": photo["links"]["download"],\n                "author": photo["user"]["name"],\n                "author_url": photo["user"]["links"]["html"],\n                "unsplash_url": photo["links"]["html"],\n                "width": photo["width"],\n                "height": photo["height"]\n            }\n            images.append(image_info)\n        \n        return images\n    \n    def download_image(self, image_url: str, filename: str) -> bool:\n        """\n        下载图片到本地\n        \n        Args:\n            image_url: 图片URL\n            filename: 保存的文件名\n            \n        Returns:\n            下载是否成功\n        """\n        try:\n            response = requests.get(image_url)\n            response.raise_for_status()\n            \n            with open(filename, \'wb\') as f:\n                f.write(response.content)\n            \n            print(f"图片已保存为: {filename}")\n            return True\n        except Exception as e:\n            print(f"下载图片失败: {e}")\n            return False\n    \n    def search_and_display(self, keywords: List[str]) -> Dict[str, List[Dict]]:\n        """\n        批量搜索多个关键词并显示结果\n        \n        Args:\n            keywords: 关键词列表\n            \n        Returns:\n            每个关键词对应的图片结果\n        """\n        all_results = {}\n        \n        for keyword in keywords:\n            print(f"\\n🔍 搜索关键词: {keyword}")\n            print("-" * 50)\n            \n            images = self.get_image_urls(keyword, count=3)\n            all_results[keyword] = images\n            \n            if images:\n                for i, img in enumerate(images, 1):\n                    print(f"{i}. 描述: {img[\'description\'][:50]}...")\n                    print(f"   URL: {img[\'url\']}")\n                    print(f"   作者: {img[\'author\']}")\n                    print(f"   尺寸: {img[\'width\']}x{img[\'height\']}")\n                    print()\n            else:\n                print("未找到相关图片")\n        \n        return all_results\n\n# 使用示例\ndef main():\n    # 注意：您需要在 https://unsplash.com/developers 注册并获取API密钥\n    ACCESS_KEY = "YOUR_UNSPLASH_ACCESS_KEY"  # 请替换为您的实际API密钥\n    \n    # 如果没有API密钥，可以使用演示模式（仅显示URL格式）\n    if ACCESS_KEY == "YOUR_UNSPLASH_ACCESS_KEY":\n        print("⚠️  请先设置您的Unsplash API密钥")\n        print("1. 访问 https://unsplash.com/developers")\n        print("2. 创建应用并获取Access Key")\n        print("3. 将ACCESS_KEY变量替换为您的实际密钥")\n        print("\\n以下是代码使用示例：")\n        \n        # 演示如何构建图片URL\n        demo_keywords = [\n            "Shanghai fishing lake park scenery",\n            "fishing equipment tackle box rod reel", \n            "four seasons fishing angler different weather",\n            "fishing safety life jacket water safety"\n        ]\n        \n        print("\\n📋 搜索关键词列表：")\n        for i, keyword in enumerate(demo_keywords, 1):\n            print(f"{i}. {keyword}")\n            # 构建Unsplash搜索URL\n            search_url = f"https://unsplash.com/s/photos/{keyword.replace(\' \', \'-\')}"\n            print(f"   搜索链接: {search_url}")\n        \n        return\n    \n    # 实际使用API\n    unsplash = UnsplashImageSearch(ACCESS_KEY)\n    \n    # 定义搜索关键词（对应文章中的图片需求）\n    fishing_keywords = [\n        "Shanghai fishing lake park scenery",           # 上海公园湖泊钓鱼风景\n        "fishing equipment tackle box rod reel",       # 钓鱼装备工具箱\n        "four seasons fishing angler different weather", # 四季钓鱼不同天气\n        "fishing safety life jacket water safety"      # 钓鱼安全救生衣\n    ]\n    \n    # 批量搜索并显示结果\n    results = unsplash.search_and_display(fishing_keywords)\n    \n    # 生成HTML图片标签\n    print("\\n" + "="*60)\n    print("🖼️  HTML图片标签生成")\n    print("="*60)\n    \n    for keyword, images in results.items():\n        if images:\n            best_image = images[0]  # 选择第一张（最相关的）图片\n            print(f"\\n关键词: {keyword}")\n            print(f\'<img src="{best_image["url"]}" alt="{keyword}">\')\n            print(f\'<!-- 作者: {best_image["author"]} | 来源: Unsplash -->\')\n\nif __name__ == "__main__":\n    main()\nEOF'}}
