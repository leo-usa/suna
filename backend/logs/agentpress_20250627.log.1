ronment!", "tool_calls": null}', 'metadata': '{"thread_run_id": "55e9dcb0-acdc-4732-821d-da0308d1d86d", "stream_status": "complete"}', 'created_at': '2025-06-27T18:19:59.52314+00:00', 'updated_at': '2025-06-27T18:19:59.52314+00:00'}
