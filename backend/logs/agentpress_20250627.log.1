Agent.includes(\'firefox\');\\n    const isSafari = userAgent.includes(\'safari\') && !userAgent.includes(\'chrome\');\\n    const isEdge = userAgent.includes(\'edge\');\\n    const isMobile = /android|iphone|ipad|ipod|blackberry|iemobile|opera mini/i.test(userAgent);\\n    \\n    let recommendedMethod = \'embed\';\\n    let warningMessage = \'\';\\n    \\n    if (isMobile) {\\n        recommendedMethod = \'object\';\\n        warningMessage = \'\\u68c0\\u6d4b\\u5230\\u79fb\\u52a8\\u8bbe\\u5907\\uff0c\\u5efa\\u8bae\\u4f7f\\u7528Object\\u6807\\u7b7e\\u6216\\u4e0b\\u8f7dPDF\\u67e5\\u770b\\u3002\';\\n    } else if (isSafari) {\\n        recommendedMethod = \'object\';\\n        warningMessage = \'\\u68c0\\u6d4b\\u5230Safari\\u6d4f\\u89c8\\u5668\\uff0c\\u5efa\\u8bae\\u4f7f\\u7528Object\\u6807\\u7b7e\\u83b7\\u5f97\\u66f4\\u597d\\u7684\\u517c\\u5bb9\\u6027\\u3002\';\\n    } else if (isFirefox) {\\n        recommendedMethod = \'embed\';\\n        warningMessage = \'\\u68c0\\u6d4b\\u5230Firefox\\u6d4f\\u89c8\\u5668\\uff0cEmbed\\u6807\\u7b7e\\u5e94\\u8be5\\u5de5\\u4f5c\\u826f\\u597d\\u3002\';\\n    }\\n    \\n    if (warningMessage) {\\n        console.log(\'\\u6d4f\\u89c8\\u5668\\u517c\\u5bb9\\u6027\\u63d0\\u793a:\', warningMessage);\\n        \\n        // \\u53ef\\u9009\\uff1a\\u663e\\u793a\\u7528\\u6237\\u63d0\\u793a\\n        const tipDiv = document.createElement(\'div\');\\n        tipDiv.style.cssText = `\\n            position: fixed;\\n            top: 10px;\\n            right: 10px;\\n            background: #fff3cd;\\n            border: 1px solid #ffeaa7;\\n            padding: 10px;\\n            border-radius: 5px;\\n            max-width: 300px;\\n            font-size: 12px;\\n            z-index: 1000;\\n            box-shadow: 0 2px 5px rgba(0,0,0,0.2);\\n        `;\\n        tipDiv.innerHTML = `\\n            <strong>\\u6d4f\\u89c8\\u5668\\u63d0\\u793a\\uff1a</strong><br>\\n            ${warningMessage}\\n            <button onclick=\\"this.parentElement.