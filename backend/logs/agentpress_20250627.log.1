turn srt_captions, xml_captions, True\\n        else:\\n            return \\"No captions available for this video\\", \\"\\", False\\n            \\n    except Exception as e:\\n        return f\\"Error extracting transcript: {str(e)}\\", \\"\\", False\\n\\nif __name__ == \\"__main__\\":\\n    url = \\"https://youtu.be/9ybK0TGU2xE?si=AUp5j0CPpFHL0bB_\\"\\n    \\n    print(f\\"Attempting to extract transcript using pytube for: {url}\\")\\n    srt_transcript, xml_transcript, success = extract_transcript_pytube(url)\\n    \\n    if success:\\n        print(\\"Transcript extracted successfully!\\")\\n        print(\\"=\\" * 50)\\n        print(\\"SRT FORMAT:\\")\\n        print(srt_transcript[:1000] + \\"...\\" if len(srt_transcript) > 1000 else srt_transcript)\\n        \\n        # Save to files\\n        with open(\\"transcript_pytube_srt.txt\\", \\"w\\", encoding=\\"utf-8\\") as f:\\n            f.write(f\\"YouTube Video Transcript (SRT Format)\\\\n\\")\\n            f.write(f\\"URL: {url}\\\\n\\")\\n            f.write(\\"=\\" * 50 + \\"\\\\n\\\\n\\")\\n            f.write(srt_transcript)\\n        \\n        with open(\\"transcript_pytube_xml.txt\\", \\"w\\", encoding=\\"utf-8\\") as f:\\n            f.write(f\\"YouTube Video Transcript (XML Format)\\\\n\\")\\n            f.write(f\\"URL: {url}\\\\n\\")\\n            f.write(\\"=\\" * 50 + \\"\\\\n\\\\n\\")\\n            f.write(xml_transcript)\\n        \\n        print(f\\"\\\\nTranscripts saved to:\\")\\n        print(\\"- transcript_pytube_srt.txt (SRT format)\\")\\n        print(\\"- transcript_pytube_xml.txt (XML format)\\")\\n    else:\\n        print(f\\"Failed to extract transcript: {srt_transcript}\\")\\n</create-file>", "tool_calls": null}', 'metadata': '{"thread_run_id": "cd0b4683-65e7-4da7-98a5-721bec848a87", "stream_status": "complete"}', 'created_at': '2025-06-27T18:21:47.689247+00:00', 'updated_at': '2025-06-27T18:21:47.689247+00:00'}
