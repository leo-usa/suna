t("Transcript extracted successfully!")\n        print("=" * 50)\n        print("SRT FORMAT:")\n        print(srt_transcript[:1000] + "..." if len(srt_transcript) > 1000 else srt_transcript)\n        \n        # Save to files\n        with open("transcript_pytube_srt.txt", "w", encoding="utf-8") as f:\n            f.write(f"YouTube Video Transcript (SRT Format)\\n")\n            f.write(f"URL: {url}\\n")\n            f.write("=" * 50 + "\\n\\n")\n            f.write(srt_transcript)\n        \n        with open("transcript_pytube_xml.txt", "w", encoding="utf-8") as f:\n            f.write(f"YouTube Video Transcript (XML Format)\\n")\n            f.write(f"URL: {url}\\n")\n            f.write("=" * 50 + "\\n\\n")\n            f.write(xml_transcript)\n        \n        print(f"\\nTranscripts saved to:")\n        print("- transcript_pytube_srt.txt (SRT format)")\n        print("- transcript_pytube_xml.txt (XML format)")\n    else:\n        print(f"Failed to extract transcript: {srt_transcript}")'}
