avigation';\n        navContainer.style.cssText = `\n            display: flex;\n            justify-content: center;\n            gap: 10px;\n            padding: 10px;\n            background: white;\n            border-radius: 5px;\n            margin: 10px 0;\n        `;\n        \n        const prevBtn = document.createElement('button');\n        prevBtn.textContent = '上一页';\n        prevBtn.disabled = this.currentPage <= 1;\n        prevBtn.addEventListener('click', () => this.prevPage());\n        \n        const nextBtn = document.createElement('button');\n        nextBtn.textContent = '下一页';\n        nextBtn.disabled = this.currentPage >= this.totalPages;\n        nextBtn.addEventListener('click', () => this.nextPage());\n        \n        const pageSelect = document.createElement('select');\n        for (let i = 1; i <= this.totalPages; i++) {\n            const option = document.createElement('option');\n            option.value = i;\n            option.textContent = `第 ${i} 页`;\n            if (i === this.currentPage) option.selected = true;\n            pageSelect.appendChild(option);\n        }\n        pageSelect.addEventListener('change', (e) => this.goToPage(parseInt(e.target.value)));\n        \n        navContainer.appendChild(prevBtn);\n        navContainer.appendChild(pageSelect);\n        navContainer.appendChild(nextBtn);\n        \n        this.container.appendChild(navContainer);\n    }\n    \n    removeNavigationButtons() {\n        const existing = this.container.querySelector('.page-navigation');\n        if (existing) {\n            existing.remove();\n        }\n    }\n    \n    prevPage() {\n        if (this.currentPage > 1) {\n            this.currentPage--;\n            this.updateView();\n            this.updatePageInfo();\n        }\n    }\n    \n    nextPage() {\n        if (this.currentPage < this.totalPages) {\n            this.currentPage++;\n            this.updateView();\n            this.updatePageInfo();\n        }\n    }\n    \n    goToPage(pageNum) {\n        if (pageNum >= 1 && pageNum <= this.totalPages) {\n            this.currentPage = pageNum;\n            this.updateView();\n            this.updatePageInfo();\n        }\n    }\n    \n    updatePageInfo() {\n        if (this.viewMode === 'single') {\n            this.pageInfo.textContent = `第 ${this.currentPage} 页，共 ${this.totalPages} 页`;\n        } else {\n            this.pageInfo.textContent = `共 ${this.totalPages} 页`;\n        }\n    }\n    \n    zoomIn() {\n        this.zoomLevel = Math.min(this.zoomLevel * 1.2, 300);\n        this.updateZoom();\n    }\n    \n    zoomOut() {\n        this.zoomLevel = Math.max(this.zoomLevel / 1.2, 50);\n        this.updateZoom();\n    }\n    \n    fitWidth() {\n        this.zoomLevel = 100;\n        this.updateZoom();\n    }\n    \n    updateZoom() {\n        const images = this.container.querySelectorAll('.report-page');\n        images.forEach(img => {\n            img.style.width = `${this.zoomLevel}%`;\n        });\n        \n        this.zoomLevelSpan.textContent = `${Math.round(this.zoomLevel)}%`;\n    }\n    \n    openFullscreen(imageSrc) {\n        const overlay = document.getElementById('fullscreen-overlay');\n        const image = document.getElementById('fullscreen-image');\n        \n        image.src = imageSrc;\n        overlay.style.display = 'flex';\n        \n        // 添加键盘事件\n        document.addEventListener('keydown', this.handleFullscreenKeydown);\n    }\n    \n    handleFullscreenKeydown(e) {\n        if (e.key === 'Escape') {\n            closeFullscreen();\n        }\n    }\n}\n\n// 全屏功能\nfunction closeFullscreen() {\n    const overlay = document.getElementById('fullscreen-overlay');\n    overlay.style.display = 'none';\n    document.removeEventListener('keydown', handleFullscreenKeydown);\n}\n\n// 视图控制\ndocument.addEventListener('DOMContentLoaded', function() {\n    // 初始化图片查看器\n    const claudeViewer = new ImageViewer('claude-image-container', 'claude_report', 10, 'claude');\n    const deepseekViewer = new ImageViewer('deepseek-image-container', 'deepseek_report', 4, 'deepseek');\n    \n    // 视图切换功能\n    const sideBySideBtn = document.getElementById('side-by-side-btn');\n    const singleViewBtn = document.getElementById('single-view-btn');\n    const claudeBtn = document.getElementById('claude-btn');\n    const deepseekBtn = document.getElementById('deepseek-btn');\n    const comparisonContainer = document.getElementById('comparison-container');\n    const claudeContainer = document.getElementById('claude-container');\n    const deepseekContainer = document.getElementById('deepseek-container');\n    const modelSelector = document.getElementById('model-selector');\n\n    let viewMode = 'side-by-side';\n    \n    sideBySideBtn.addEventListener('click', function() {\n        if (viewMode !== 'side-by-side') {\n            viewMode = 'side-by-side';\n            updateViewMode();\n            \n            sideBySideBtn.classList.add('active');\n            singleViewBtn.classList.remove('active');\n            modelSelector.style.visibility = 'hidden';\n        }\n    });\n    \n    singleViewBtn.addEventListener('click', function() {\n        if (viewMode !== 'single') {\n            viewMode = 'single';\n            updateViewMode();\n            \n            singleViewBtn.classList.add('active');\n            sideBySideBtn.classList.remove('active');\n            modelSelector.style.visibility = 'visible';\n            \n            showReport('claude');\n        }\n    });\n    \n    claudeBtn.addEventListener('click', function() {\n        if (viewMode === 'single') {\n            showReport('claude');\n        }\n    });\n    \n    deepseekBtn.addEventListener('click', function() {\n        if (viewMode === 'single') {\n            showReport('deepseek');\n        }\n    });\n    \n    function updateViewMode() {\n        if (viewMode === 'side-by-side') {\n            comparisonContainer.classList.remove('single-view');\n            claudeContainer.classList.remove('active');\n            deepseekContainer.classList.remove('active');\n        } else {\n            comparisonContainer.classList.add('single-view');\n        }\n    }\n    \n    function showReport(report) {\n        if (report === 'claude') {\n            claudeContainer.classList.add('active');\n            deepseekContainer.classList.remove('active');\n            claudeBtn.classList.add('active');\n            deepseekBtn.classList.remove('active');\n        } else {\n            deepseekContainer.classList.add('active');\n            claudeContainer.classList.remove('active');\n            deepseekBtn.classList.add('active');\n            claudeBtn.classList.remove('active');\n        }\n    }\n    \n    // 初始化\n    modelSelector.style.visibility = 'hidden';\n    \n    // 响应式处理\n    window.addEventListener('resize', function() {\n        if (window.innerWidth < 768 && viewMode !== 'single') {\n            singleViewBtn.click();\n        }\n    });\n    \n    if (window.innerWidth < 768) {\n        singleViewBtn.click();\n    }\n    \n    // 全屏覆盖层点击关闭\n    document.getElementById('fullscreen-overlay').addEventListener('click', function(e) {\n        if (e.target === this) {\n            closeFullscreen();\n        }\n    });\n});"} (tool_call id: N/A)
