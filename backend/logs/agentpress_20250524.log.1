8\\u6c34\\u8349\\u4e30\\u5bcc\\u3001\\u6c34\\u6df11-3\\u7c73\\u7684\\u533a\\u57df\\u6d3b\\u52a8\\uff0c\\u6742\\u98df\\u6027\\uff0c\\u56db\\u5b63\\u5747\\u53ef\\u5782\\u9493</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u6625\\u79cb\\u4e24\\u5b63\\uff0c\\u65e9\\u6668\\u548c\\u508d\\u665a\\u6d3b\\u8dc3\\u5ea6\\u6700\\u9ad8</p>\\n                        <p><strong>\\u63a8\\u8350\\u9493\\u6cd5\\uff1a</strong>\\u53f0\\u9493\\u3001\\u4f20\\u7edf\\u9493\\uff0c\\u4f7f\\u7528\\u7ec6\\u7ebf\\u5c0f\\u94a9</p>\\n                    </div>\\n\\n                    <div class=\\"info-card\\">\\n                        <h4>\\ud83d\\udc20 \\u9ca4\\u9c7c\\uff08Cyprinus carpio\\uff09</h4>\\n                        <p><strong>\\u7279\\u5f81\\uff1a</strong>\\u4f53\\u578b\\u8f83\\u5927\\uff0c\\u6210\\u9c7c\\u53ef\\u8fbe2-10\\u516c\\u65a4\\uff0c\\u4f53\\u8272\\u91d1\\u9ec4\\u6216\\u9752\\u7070\\uff0c\\u529b\\u91cf\\u5f3a\\u52b2</p>\\n                        <p><strong>\\u4e60\\u6027\\uff1a</strong>\\u5e95\\u6816\\u6027\\u9c7c\\u7c7b\\uff0c\\u559c\\u6b22\\u5728\\u6ce5\\u5e95\\u89c5\\u98df\\uff0c\\u8b66\\u89c9\\u6027\\u9ad8\\uff0c\\u559c\\u6b22\\u5b89\\u9759\\u73af\\u5883</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u6625\\u672b\\u590f\\u521d\\u548c\\u79cb\\u5b63\\uff0c\\u591c\\u9493\\u6548\\u679c\\u66f4\\u4f73</p>\\n                        <p><strong>\\u63a8\\u8350\\u9493\\u6cd5\\uff1a</strong>\\u5e95\\u9493\\u3001\\u591c\\u9493\\uff0c\\u4f7f\\u7528\\u7c97\\u7ebf\\u5927\\u94a9</p>\\n                    </div>\\n\\n                    <div class=\\"info-card\\">\\n                        <h4>\\ud83c\\udf3f \\u8349\\u9c7c\\uff08Ctenopharyngodon idellus\\uff09</h4>\\n                        <p><strong>\\u7279\\u5f81\\uff1a</strong>\\u5927\\u578b\\u9c7c\\u7c7b\\uff0c\\u6210\\u9c7c\\u53ef\\u8fbe5-20\\u516c\\u65a4\\uff0c\\u4f53\\u578b\\u4fee\\u957f\\uff0c\\u6e38\\u901f\\u5feb</p>\\n                        <p><strong>\\u4e60\\u6027\\uff1a</strong>\\u8349\\u98df\\u6027\\u4e3a\\u4e3b\\uff0c\\u559c\\u6b22\\u5728\\u6c34\\u8349\\u8fb9\\u7f18\\u6d3b\\u52a8\\uff0c\\u4e2d\\u4e0a\\u5c42\\u6e38\\u5f0b</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u590f\\u79cb\\u5b63\\u8282\\uff0c\\u6c34\\u6e29\\u8f83\\u9ad8\\u65f6\\u6d3b\\u8dc3</p>\\n                        <p><strong>\\u63a8\\u8350\\u9493\\u6cd5\\uff1a</strong>\\u6d6e\\u9493\\u3001\\u5e95\\u9493\\uff0c\\u4f7f\\u7528\\u690d\\u7269\\u6027\\u9975\\u6599</p>\\n                    </div>\\n\\n                    <div class=\\"info-card\\">\\n                        <h4>\\u26ab \\u9752\\u9c7c\\uff08Mylopharyngodon piceus\\uff09</h4>\\n                        <p><strong>\\u7279\\u5f81\\uff1a</strong>\\u5927\\u578b\\u5e95\\u6816\\u9c7c\\u7c7b\\uff0c\\u4f53\\u8272\\u9752\\u9ed1\\uff0c\\u53ef\\u8fbe10-30\\u516c\\u65a4</p>\\n                        <p><strong>\\u4e60\\u6027\\uff1a</strong>\\u4e3b\\u8981\\u4ee5\\u87ba\\u86f3\\u3001\\u868c\\u7c7b\\u4e3a\\u98df\\uff0c\\u529b\\u91cf\\u6781\\u5927\\uff0c\\u6218\\u6597\\u529b\\u5f3a</p>\\n                        <p><strong>\\u6700\\u4f73\\u65f6\\u95f4\\uff1a</strong>\\u6625\\u672b\\u81f3\\u79cb\\u521d\\uff0c\\u6c14\\u6e29\\u7a33\\u5b9a\\u65f6</p>\\n                        <p><strong>\\u63a8\\u8350\\u9493\\u6cd5\\uff1a</strong>\\u91cd\\u5e95\\u9493\\uff0c\\u4f7f\\u7528\\u87ba\\u86f3\\u3001\\u86af\\u8693\\u7b49\\u8364\\u9975</p>\\n                    </div>\\n\\n                    <div class=\\"info-card\\">\\n                        <h4>\\ud83d\\udd34 \\u9cca\\u9c7c\\uff08Parabramis pekinensis\\uff09</h4>\\n                        <p><strong>\\u7279\\u5f81\\uff1a</strong>\\u4e2d\\u578b\\u9c7c\\u7c7b\\uff0c\\u4f53\\u578b\\u6241\\u5e73\\uff0c\\u91cd\\u91cf\\u4e00\\u822c\\u57280.5-2\\u516c\\u65a4</p>\\n                        <p><strong>\\u4e60\\u6027\\uff1a</strong>\\u7fa4\\u5c45\\u6027\\u5f3a\\uff0c\\u559c\\u6b22\\u5728\\u7f13\\u6d41\\u6c34\\u57df\\u6d3b\\u52a8