\u4f01\\u4e1a\\u589e\\u957f\\uff09\\",\\n        \\n        # Slide 20\\n        \\"Chinese Market Opportunity\\": \\"\\u4e2d\\u56fd\\u5e02\\u573a\\u673a\\u9047\\",\\n        \\"Market Size & Advantages\\": \\"\\u5e02\\u573a\\u89c4\\u6a21\\u4e0e\\u4f18\\u52bf\\",\\n        \\"904M online payment users\\": \\"9.04\\u4ebf\\u5728\\u7ebf\\u652f\\u4ed8\\u7528\\u6237\\",\\n        \\"92.8% digital payment penetration\\": \\"92.8%\\u7684\\u6570\\u5b57\\u652f\\u4ed8\\u666e\\u53ca\\u7387\\",\\n        \\"$65B AI market by 2030\\": \\"\\u52302030\\u5e74AI\\u5e02\\u573a\\u89c4\\u6a21650\\u4ebf\\u7f8e\\u5143\\",\\n        \\"First-mover advantage\\": \\"\\u5148\\u53d1\\u4f18\\u52bf\\",\\n        \\"Native payment integr\\": \\"\\u672c\\u5730\\u652f\\u4ed8\\u96c6\\u6210\\",\\n        \\n        # Slide 21\\n        \\"Implementation Roadmap\\": \\"\\u5b9e\\u65bd\\u8def\\u7ebf\\u56fe\\",\\n        \\"Phase 1: Foundation (Months 1-6)\\": \\"\\u7b2c1\\u9636\\u6bb5\\uff1a\\u57fa\\u7840\\uff081-6\\u4e2a\\u6708\\uff09\\",\\n        \\"Core platform development with Claude 4\\": \\"\\u4f7f\\u7528Claude 4\\u5f00\\u53d1\\u6838\\u5fc3\\u5e73\\u53f0\\",\\n        \\"PPT generation engine development\\": \\"PPT\\u751f\\u6210\\u5f15\\u64ce\\u5f00\\u53d1\\",\\n        \\"Phase 2: Market Entry (Months 7-12\\": \\"\\u7b2c2\\u9636\\u6bb5\\uff1a\\u5e02\\u573a\\u8fdb\\u5165\\uff087-12\\u4e2a\\u6708\\uff09\\",\\n        \\n        # Slide 23\\n        \\"Ready to Experience the Future?\\": \\"\\u51c6\\u5907\\u4f53\\u9a8c\\u672a\\u6765\\u4e86\\u5417\\uff1f\\",\\n        \\"Free Registration & Trial\\": \\"\\u514d\\u8d39\\u6ce8\\u518c\\u4e0e\\u8bd5\\u7528\\",\\n        \\"Experience superior content creation\\": \\"\\u4f53\\u9a8c\\u5353\\u8d8a\\u7684\\u5185\\u5bb9\\u521b\\u4f5c\\",\\n        \\"Professional PPT generation\\": \\"\\u4e13\\u4e1aPPT\\u751f\\u6210\\",\\n        \\"Chinese localization\\": \\"\\u4e2d\\u6587\\u672c\\u5730\\u5316\\",\\n        \\"Join the\\": \\"\\u52a0\\u5165\\"\\n    }\\n    \\n    # Check if the text is in the translations dictionary\\n    if text in translations:\\n        return translations[text]\\n    \\n    # If the text contains Chinese characters, assume it\'s already in Chinese and return as is\\n    if any(\'\\\\u4e00\' <= char <= \'\\\\u9fff\' for char in text):\\n        return text\\n    \\n    # For partial matches (text might be truncated in the analysis)\\n    for eng, chn in translations.items():\\n        if eng in text:\\n            return text.replace(eng, chn)\\n    \\n    # If no translation is found, return the original text\\n    return text\\n\\ndef process_pptx(input_file, output_file):\\n    \\"\\"\\"\\n    Process the PowerPoint file, replacing English text with Chinese.\\n    \\"\\"\\"\\n    if not os.path.exists(input_file):\\n        print(f\\"Input file not found: {input_file}\\")\\n        return False\\n    \\n    prs = Presentation(input_file)\\n    \\n    # Process each slide\\n    for slide in prs.slides:\\n        # Process each shape in the slide\\n        for shape in slide.shapes:\\n            if hasattr(shape, \\"text_frame\\") and shape.text.strip():\\n                # Process each paragraph in the text frame\\n                for paragraph in shape.text_frame.paragraphs:\\n                    # Process each run in the paragraph\\n                    for run in paragraph.runs:\\n                        # Check if the text is in English (doesn\'t contain Chinese characters)\\n                        if not any(\'\\\\u4e00\' <= char <= \'\\\\u9fff\' for char in run.text):\\n                            # Replace with Chinese translation\\n                            run.text = translate_to_chinese(run.text)\\n    \\n    # Save the modified presentation\\n    prs.save(output_file)\\n    print(f\\"Translated presentation saved as: {output_file}\\")\\n    return True\\n\\nif __name__ == \\"__main__\\":\\n    input_file = \\"dobby_business_plan_with_new_images.pptx\\"\\n    output_file = \\"dobby_business_plan_chinese_improved.pptx\\"\\n    \\n    success = process_pptx(input_file, output_file)\\n    if success:\\n        print(\\"Translation completed successfully!\\")\\n    else:\\n        print(\\"Translation failed.\\")\\n</create-file>"}}', 'created_at': '2025-05-26T21:49:37.490924+00:00', 'updated_at': '2025-05-26T21:49:37.490924+00:00'}
