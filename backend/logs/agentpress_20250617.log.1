             <h2 style="text-align: center; margin-bottom: 20px; border: none;">📊 项目统计</h2>\n                <div class="stats-grid">\n                    <div class="stat-item">\n                        <span class="stat-number">8</span>\n                        <div class="stat-label">完整剧本</div>\n                    </div>\n                    <div class="stat-item">\n                        <span class="stat-number">4</span>\n                        <div class="stat-label">大纲文件</div>\n                    </div>\n                    <div class="stat-item">\n                        <span class="stat-number">3</span>\n                        <div class="stat-label">总结文档</div>\n                    </div>\n                    <div class="stat-item">\n                        <span class="stat-number">15+</span>\n                        <div class="stat-label">总文件数</div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class="section">\n                <h2>📚 完整剧本文件</h2>\n                <div class="file-grid">\n                    <div class="file-card script">\n                        <div class="file-title">\n                            <span class="file-icon">🎬</span>\n                            第5集：《越狱》\n                        </div>\n                        <div class="file-description">\n                            李焰主动策划越狱，展示智谋和决心，与杨以漂感情升温，开始反击章安民。关键转折点，从被动转为主动。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type script">完整剧本</span>\n                            <span>hot_blood_episode5.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card script">\n                        <div class="file-title">\n                            <span class="file-icon">🔍</span>\n                            第6集：《暗中调查》\n                        </div>\n                        <div class="file-description">\n                            李焰深入银矿调查真相，发现章安民杀害其母的证据，于继滔倒戈相助，收集关键证据。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type script">完整剧本</span>\n                            <span>hot_blood_episode6_script.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card script">\n                        <div class="file-title">\n                            <span class="file-icon">⚔️</span>\n                            第7集：《身份危机》\n                        </div>\n                        <div class="file-description">\n                            杨以漂被绑架，李焰冒险营救，确认章安民是陷害他的主谋，决定主动出击反击。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type script">完整剧本</span>\n                            <span>hot_blood_episode7_script.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card script">\n                        <div class="file-title">\n                            <span class="file-icon">🗡️</span>\n                            第8集：《反击开始》\n                        </div>\n                        <div class="file-description">\n                            李焰与章安民正面对质，杨崇开始支持李焰，各方势力博弈加剧，战局开始逆转。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type script">完整剧本</span>\n                            <span>hot_blood_episode8_script.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card script">\n                        <div class="file-title">\n                            <span class="file-icon">🎭</span>\n                            第9集：《局中局》\n                        </div>\n                        <div class="file-description">\n                            李焰假意与浩万年合作，成功挑拨章安民与浩家关系，浩亚男倒戈相助，敌人内部分裂。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type script">完整剧本</span>\n                            <span>hot_blood_episode9_script.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card script">\n                        <div class="file-title">\n                            <span class="file-icon">💡</span>\n                            第10集：《真相大白》\n                        </div>\n                        <div class="file-description">\n                            李焰收集到足够证据，章安民杀害浩亚男灭口，杨崇召集官员准备公审，真相即将大白。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type script">完整剧本</span>\n                            <span>hot_blood_episode10_script.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card script">\n                        <div class="file-title">\n                            <span class="file-icon">⚖️</span>\n                            第11集：《大审判》\n                        </div>\n                        <div class="file-description">\n                            钦差主持大审，李焰当庭指控章安民，各方证人作证，章安民等恶人被判死刑，正义得到伸张。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type script">完整剧本</span>\n                            <span>hot_blood_episode11_script.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card script">\n                        <div class="file-title">\n                            <span class="file-icon">🌅</span>\n                            第12集：《正义终现》\n                        </div>\n                        <div class="file-description">\n                            恶人伏法，李焰获得嘉奖成为捕头，与杨以漂结为夫妻，实现人生理想，圆满大结局。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type script">完整剧本</span>\n                            <span>hot_blood_episode12_script.txt</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class="section">\n                <h2>📋 大纲规划文件</h2>\n                <div class="file-grid">\n                    <div class="file-card outline">\n                        <div class="file-title">\n                            <span class="file-icon">📝</span>\n                            第6集大纲\n                        </div>\n                        <div class="file-description">\n                            第6集《暗中调查》的详细大纲，包含场景设置、人物发展、情感线索和关键转折点。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type outline">大纲文件</span>\n                            <span>hot_blood_episode6_outline.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card outline">\n                        <div class="file-title">\n                            <span class="file-icon">📝</span>\n                            第7集大纲\n                        </div>\n                        <div class="file-description">\n                            第7集《身份危机》的详细大纲，重点描述李焰营救杨以漂和确认章安民身份的过程。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type outline">大纲文件</span>\n                            <span>hot_blood_episode7_outline.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card outline">\n                        <div class="file-title">\n                            <span class="file-icon">📝</span>\n                            第8集大纲\n                        </div>\n                        <div class="file-description">\n                            第8集《反击开始》的详细大纲，展现李焰从防守转为进攻的战略转变。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type outline">大纲文件</span>\n                            <span>hot_blood_episode8_outline.txt</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card outline">\n                        <div class="file-title">\n                            <span class="file-icon">📝</span>\n                            第9-12集综合大纲\n                        </div>\n                        <div class="file-description">\n                            第9-12集的综合大纲，详细规划了最后四集的剧情发展、人物命运和主题升华。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type outline">大纲文件</span>\n                            <span>hot_blood_episodes9to12_outline.txt</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class="section">\n                <h2>📊 总结分析文件</h2>\n                <div class="file-grid">\n                    <div class="file-card summary">\n                        <div class="file-title">\n                            <span class="file-icon">🔧</span>\n                            剧本改进说明\n                        </div>\n                        <div class="file-description">\n                            详细说明如何根据审评意见改进剧本，包括人物塑造、叙事视角、结构优化等方面的具体改进措施。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type summary">改进文档</span>\n                            <span>script_improvements_summary.md</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card summary">\n                        <div class="file-title">\n                            <span class="file-icon">📈</span>\n                            完整系列总结\n                        </div>\n                        <div class="file-description">\n                            《热血捕快》完整剧本创作总结，包含项目概述、创作特色、市场价值分析等综合信息。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type summary">总结文档</span>\n                            <span>complete_series_summary.md</span>\n                        </div>\n                    </div>\n                    \n                    <div class="file-card summary">\n                        <div class="file-title">\n                            <span class="file-icon">📚</span>\n                            原始资料文件\n                        </div>\n                        <div class="file-description">\n                            包含原始人物大纲、审评意见、总体规划等基础资料文件，为剧本创作提供参考依据。\n                        </div>\n                        <div class="file-meta">\n                            <span class="file-type summary">参考资料</span>\n                            <span>hot_blood_*.txt, overall_plan.md</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class="section">\n                <h2>🎯 项目亮点</h2>\n                <div style="background: #f8f9fa; padding: 30px; border-radius: 10px; margin-top: 20px;">\n                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">\n                        <div style="text-align: center; padding: 20px;">\n                            <div style="font-size: 2em; margin-bottom: 10px;">🎭</div>\n                            <h3 style="color: #2c3e50; margin-bottom: 10px;">人物立体</h3>\n                            <p style="color: #666;">主角李焰从被动到主动的完整蜕变，配角各具特色推动剧情</p>\n                        </div>\n                        <div style="text-align: center; padding: 20px;">\n                            <div style="font-size: 2em; margin-bottom: 10px;">⚡</div>\n                            <h3 style="color: #2c3e50; margin-bottom: 10px;">节奏紧凑</h3>\n                            <p style="color: #666;">每集都有高潮转折，悬念设置合理，观众粘性强</p>\n                        </div>\n                        <div style="text-align: center; padding: 20px;">\n                            <div style="font-size: 2em; margin-bottom: 10px;">🌟</div>\n                            <h3 style="color: #2c3e50; margin-bottom: 10px;">主题积极</h3>\n                            <p style="color: #666;">弘扬正义必胜价值观，展现小人物奋斗精神</p>\n                        </div>\n                        <div style="text-align: center; padding: 20px;">\n                            <div style="font-size: 2em; margin-bottom: 10px;">💰</div>\n                            <h3 style="color: #2c3e50; margin-bottom: 10px;">市场价值</h3>\n                            <p style="color: #666;">制作可行性强，传播价值高，符合主流审美</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <div class="footer">\n            <p>《热血捕快》- 12集古装励志传奇剧完整剧本</p>\n            <p style="margin-top: 10px; opacity: 0.8;">一个关于正义、勇气和成长的故事</p>\n            <p style="margin-top: 10px; font-size: 0.9em; opacity: 0.7;">\n                创作完成时间：2025年 | 总字数：约15万字 | 文件格式：TXT/MD\n            </p>\n        </div>\n    </div>\n</body>\n</html>'} (tool_call id: N/A)
