# Copy this file to `.env` in this directory (`apps/bridges/.env`), then fill in values.
# `.env` is gitignored (see repo root .gitignore). Secrets here must match the backend
# for the same keys (e.g. TELEGRAM_BRIDGE_SECRET, WECHAT_ILINK_BRIDGE_SECRET).

# Backend API base URL including /v1
API_BASE=http://127.0.0.1:8000/v1

# Telegram — TELEGRAM_BRIDGE_SECRET must match backend TELEGRAM_BRIDGE_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_BRIDGE_SECRET=

# WeChat iLink — must match backend WECHAT_ILINK_BRIDGE_SECRET
WECHAT_ILINK_BRIDGE_SECRET=

# Optional: where iLink saves the bot token after QR login (working directory relative)
# ILINK_TOKEN_FILE=./bot_token.json
