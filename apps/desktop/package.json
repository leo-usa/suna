{
  "name": "dobby-desktop",
  "version": "2.0.0",
  "description": "Dobby Desktop",
  "author": {
    "name": "Dobby",
    "email": "support@dobby.now",
    "url": "https://dobby.now"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test runner/workspace.test.js runner/computer.test.js",
    "build": "electron-builder",
    "build:mac": "node -r dotenv/config -e 'require(\"./build-signed.js\")' || electron-builder --mac",
    "build:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "app:local": "node make-local-app.js",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.3.2",
    "dotenv": "^16.4.5",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dobby.desktop",
    "productName": "Dobby",
    "protocols": {
      "name": "Dobby",
      "schemes": [
        "dobby"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Dobby uses Apple Events to type, click, and open apps on this Mac.",
        "NSScreenCaptureUsageDescription": "Dobby captures the screen so it can see what is on this computer.",
        "NSDocumentsFolderUsageDescription": "Dobby saves this project's files in Documents/Dobby so it can list, read, and edit them on this Mac.",
        "NSDesktopFolderUsageDescription": "Dobby can use files on your Desktop when a project needs them.",
        "NSDownloadsFolderUsageDescription": "Dobby can use files in Downloads when a project needs them."
      }
    },
    "afterSign": "notarize.js",
    "dmg": {
      "sign": false,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "extraResources": [
      {
        "from": "runner",
        "to": "runner",
        "filter": [
          "**/*",
          "!**/*.test.js"
        ]
      },
      {
        "from": "node_modules/ws",
        "to": "runner/node_modules/ws"
      }
    ]
  }
}
